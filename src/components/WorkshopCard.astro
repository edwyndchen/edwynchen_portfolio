---
import Plate from './Plate.astro';
import { STATUS_LABEL, hasWriteup, skillKey, type WorkshopStatus } from '../lib/workshop';

interface Props {
  entry: {
    id: string;
    body?: string;
    data: {
      title: string; date: Date; draft: boolean; status: WorkshopStatus; blurb: string; skills: string[];
      image?: string | null; imageAlt: string; link?: string | null; linkLabel: string;
    };
  };
}
const { entry } = Astro.props;
const d = entry.data;
const page = hasWriteup(entry) ? `/workshop/${entry.id}/` : null;
const month = d.date.toLocaleDateString('en-AU', { month: 'short', year: 'numeric', timeZone: 'UTC' });
const external = d.link && /^https?:/.test(d.link);
---
<Plate as="article" class="wcard">
  <div data-skills={d.skills.map(skillKey).join(' ')} class="wcard__inner">
    {d.image && <div class="wcard__media"><img src={d.image} alt={page ? '' : d.imageAlt} width="800" height="500" loading="lazy" decoding="async" /></div>}
    <p class="wcard__meta">
      <span class:list={['wcard__status', `wcard__status--${d.status}`]}>{STATUS_LABEL[d.status]}</span>
      <time datetime={d.date.toISOString().slice(0, 10)}>{month}</time>
      {d.draft && <span class="wcard__draft">Draft</span>}
    </p>
    <h2 class="wcard__title">{page ? <a href={page}>{d.title}</a> : d.title}</h2>
    <p class="wcard__blurb">{d.blurb}</p>
    {d.skills.length > 0 && (
      <ul class="wcard__skills" aria-label="Skills and tools">
        {d.skills.map((s) => <li>{s}</li>)}
      </ul>
    )}
    {(page || d.link) && (
      <p class="wcard__links">
        {page && <a href={page}>Read the write-up<span aria-hidden="true"> →</span></a>}
        {d.link && (
          <a href={d.link} {...(external ? { target: '_blank', rel: 'noopener' } : {})}>
            {d.linkLabel || 'Visit'}<span aria-hidden="true"> ↗</span>{external && <span class="visually-hidden"> (opens in a new tab)</span>}
          </a>
        )}
      </p>
    )}
  </div>
</Plate>

<style>
  .wcard__inner { display: flex; flex-direction: column; height: 100%; }
  .wcard__media { margin-bottom: var(--space-m); overflow: hidden; }
  .wcard__media img { display: block; width: 100%; height: auto; mix-blend-mode: multiply; }
  .wcard__meta { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-xs) var(--space-s); margin: 0 0 var(--space-xs); font-size: var(--text-sm); color: var(--text-secondary); }
  /* DS badge, pill: cobalt for work in progress, celadon (rare) once shipped, neutral ink for experiments */
  .wcard__status {
    display: inline-flex; align-items: center; padding: 5px 11px; line-height: 1;
    font-size: var(--text-xs); font-weight: var(--fw-semibold); letter-spacing: var(--ls-caps); text-transform: uppercase;
    border: 1px solid var(--border-default); border-radius: var(--radius-round);
    color: var(--text-brand); background: var(--surface-brand-soft);
  }
  .wcard__status--shipped { color: var(--celadon-500); border-color: var(--celadon-300); background: transparent; }
  .wcard__status--experiment { color: var(--text-secondary); border-color: var(--border-ink); background: transparent; }
  .wcard__draft { color: var(--text-seal); font-weight: var(--fw-semibold); }
  .wcard__title { font-size: var(--fluid-display-md); margin: var(--space-xs) 0 var(--space-s); }
  .wcard__title a { color: var(--cobalt); text-decoration: none; }
  .wcard__title a:hover { color: var(--action-primary-hover); text-decoration: underline; }
  .wcard__blurb { margin: 0 0 var(--space-m); max-width: 52ch; color: var(--text-secondary); }
  .wcard__skills { list-style: none; padding: 0; margin: 0 0 var(--space-m); display: flex; flex-wrap: wrap; gap: var(--space-2); }
  /* DS badge, tag: square hairline */
  .wcard__skills li { padding: 4px 9px; font-size: var(--text-xs); border: 1px solid var(--border-hairline); color: var(--text-brand); }
  .wcard__links { margin: auto 0 0; display: flex; flex-wrap: wrap; gap: var(--space-xs) var(--space-l); }
  .wcard__links a { display: inline-flex; align-items: center; min-height: 44px; font-weight: var(--fw-semibold); color: var(--cobalt); }
</style>
