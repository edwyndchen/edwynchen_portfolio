    <g fill="none" stroke="currentColor" stroke-width="1.75" stroke-linejoin="round" stroke-linecap="round">
      <rect x="2.5" y="4.75" width="19" height="14.5" rx="1.5" />
      <path d="M3.25 6l8.75 7 8.75-7" />
    </g>
  )}
