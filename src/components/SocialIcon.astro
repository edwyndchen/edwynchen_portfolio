---
// Email, LinkedIn and Behance as icons (Ed, 2026-10-05: icons instead of the names). Decorative: the link around
// each one carries its accessible name. currentColor, so they take the link's cobalt and hover states.
interface Props { name: 'mail' | 'linkedin' | 'behance'; class?: string }
const { name, class: className } = Astro.props;
