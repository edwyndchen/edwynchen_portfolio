---
interface Item { id: string; data: { title: string } }
interface Props { prev: Item; next: Item }
const { prev, next } = Astro.props;
---
<nav class="casenav wrap" aria-label="More case studies">
  <a href={`/work/${prev.id}/`} rel="prev"><span class="label">Previous</span><span>{prev.data.title}</span></a>
  <a href={`/work/${next.id}/`} rel="next"><span class="label">Next</span><span>{next.data.title}</span></a>
</nav>

<style>
  .casenav { display: flex; justify-content: space-between; gap: var(--space-l); border-top: var(--rule); padding-block: var(--space-m) var(--space-2xl); margin-top: var(--space-2xl); }
  .casenav a { display: grid; gap: 0.35rem; align-content: start; text-decoration: none; font-family: var(--font-display); font-size: var(--step-2); line-height: 1.1; min-height: 44px; color: var(--cobalt-ink); }
  .casenav a:hover > span:last-child, .casenav a:focus-visible > span:last-child { text-decoration: underline; text-decoration-thickness: 1px; }
  .casenav .label { font-family: var(--font-body); font-size: var(--step--1); line-height: 1.6; color: var(--gold-text); }
  .casenav a[rel='prev'] .label::before { content: '\2190\00a0'; }
  .casenav a[rel='next'] .label::after { content: '\00a0\2192'; }
  .casenav a[rel='next'] { text-align: right; }
</style>
