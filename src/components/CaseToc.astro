---
// The case study's section tabs: anchor links set on the bottom edge of the blue band. The row sticks under the nav
// while you read (turning solid cobalt once it leaves the band), and the tab for the section you are in is marked
// (aria-current) and drawn in paper, as if it opens onto the page.
interface Props { headings: { depth: number; slug: string; text: string }[] }
const items = Astro.props.headings.filter((h) => h.depth === 2);
---
{items.length > 1 && (
  <nav class="tabs" aria-label="On this page" data-toc>
    <div class="wrap tabs__inner">
      <ol>
        {items.map((h) => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}
      </ol>
    </div>
  </nav>
)}

<style>
  .tabs {
    position: sticky; top: 4.5rem; z-index: 20; margin-top: -3rem; height: 3rem;
    transition: background-color var(--dur-med) var(--ease-standard);
  }
  .tabs.is-stuck { background: var(--surface-brand); box-shadow: var(--shadow-sm); }
  .tabs__inner { height: 100%; overflow-x: auto; scrollbar-width: none; }
  .tabs__inner::-webkit-scrollbar { display: none; }
  .tabs ol { list-style: none; margin: 0; padding: 0; display: flex; gap: 2px; height: 100%; width: max-content; }
  .tabs a {
    display: flex; align-items: center; height: 100%; min-height: 44px; padding: 0 var(--space-m);
    font-size: var(--text-sm); font-weight: var(--fw-semibold); text-decoration: none; white-space: nowrap;
    color: var(--paper-0); background: rgba(255, 255, 255, 0.1);
    transition: background-color var(--dur-med) var(--ease-standard), color var(--dur-med) var(--ease-standard);
  }
  .tabs a:hover { background: rgba(255, 255, 255, 0.2); color: var(--paper-0); }
  .tabs a:focus-visible { outline: 2px solid var(--paper-0); outline-offset: -4px; }
  .tabs a[aria-current='true'] { background: var(--surface-page); color: var(--text-brand); }
  .tabs a[aria-current='true']:focus-visible { outline-color: var(--focus-ring); }
</style>

<script>
  const toc = document.querySelector<HTMLElement>('[data-toc]');
  if (toc) {
    const row = toc.querySelector<HTMLElement>('.tabs__inner')!;
    const links = new Map([...toc.querySelectorAll<HTMLAnchorElement>('a')].map((a) => [decodeURIComponent(a.hash.slice(1)), a]));
    const heads = [...links.keys()].map((id) => document.getElementById(id)).filter((h): h is HTMLElement => Boolean(h));
    const band = document.querySelector<HTMLElement>('.case-band');
    const mark = (id: string | undefined) => {
      for (const [k, a] of links) if (k === id) a.setAttribute('aria-current', 'true'); else a.removeAttribute('aria-current');
      const a = id ? links.get(id) : undefined;
      if (a && row.scrollWidth > row.clientWidth) row.scrollTo({ left: a.offsetLeft - 16, behavior: 'auto' });
    };
    const update = () => {
      // stuck once the band's bottom edge has passed under the row
      toc.classList.toggle('is-stuck', Boolean(band && band.getBoundingClientRect().bottom <= toc.getBoundingClientRect().bottom + 1));
      // current section: the last heading past the top third of the screen (none while still in the band)
      const line = window.innerHeight * 0.33;
      let current: string | undefined;
      for (const h of heads) if (h.getBoundingClientRect().top <= line) current = h.id;
      mark(current);
    };
    let raf = 0;
    window.addEventListener('scroll', () => { cancelAnimationFrame(raf); raf = requestAnimationFrame(update); }, { passive: true });
    update();
  }
</script>
