---
import { readFileSync } from 'node:fs';
import { join } from 'node:path';
import Flora from './Flora.astro';
import { webpSize } from '../lib/image-size';

// read the portrait's real pixel size at build, so swapping the file never leaves stale width/height
const ED_SRC = '/images/ed-porcelain.webp';
const ed = webpSize(readFileSync(join(process.cwd(), 'public', ED_SRC)));
---
<section id="about" class="about wrap" aria-labelledby="about-title" data-about>
  <Flora plant="gum" side="left" class="flora--about" />
  <div class="about__text" data-reveal-on-scroll>
    <h2 id="about-title">About me<span class="about__mark" aria-hidden="true" lang="zh-Hant">陳</span></h2>
    <p>I design digital products and I care about getting them right, both how they work and how they feel to use.</p>
    <p>Coffee-fuelled designer and gym junkie. I like leaving places better than I found them, physically and digitally. Born and raised in Melbourne.</p>
    <h3 class="label">What I do</h3>
    <ul class="about__caps">
      <li>Product and UX design</li>
      <li>Design systems</li>
      <li>Accessibility</li>
      <li>Prototyping</li>
      <li>Illustration and brand</li>
    </ul>
  </div>
  <figure class="about__figure">
    <img class="about__ed" src={ED_SRC} alt="Brush painting of Edwyn flying in flowing blue-and-white robes, holding a stylus and tablet" width={ed.width} height={ed.height} loading="lazy" decoding="async" />
    <img class="about__tower" src="/hero/cloud-tower.webp" alt="" aria-hidden="true" width="1200" height="1558" loading="lazy" decoding="async" />
  </figure>
</section>

<style>
  .about {
    position: relative; display: grid; gap: var(--space-l) var(--space-xl);
    padding-top: var(--space-2xl); padding-bottom: var(--space-xl);
    grid-template-columns: minmax(0, 1fr); align-items: center;
  }
  /* the gum branch hangs above the heading on the text side, clear of Ed and of the letters */
  :global(.flora--about) { top: calc(var(--space-2xl) - 11.5rem); }
  .about__text { position: relative; z-index: 1; }
  .about h2 { font-size: var(--step-3); margin-bottom: var(--space-m); }
  .about__mark {
    font-family: var(--font-cjk); font-weight: 400; font-size: 1.1em; line-height: 1;
    color: var(--blue-300); margin-inline-start: 0.3em;
  }
  .about h3 { color: var(--gold-text); margin-top: var(--space-l); margin-bottom: var(--space-xs); }
  .about__caps { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 13rem), 1fr)); column-gap: var(--space-l); max-width: 36rem; }
  .about__caps li { border-top: var(--rule-hair); padding-block: var(--space-3); }

  /* Ed flies free on the page (no frame). He emerges from behind the cloud tower at the column's right edge,
     which bleeds off the side of the page and is drawn in front of him. At rest it sits beside his hem. */
  .about__figure { position: relative; margin: 0 auto; width: 82%; max-width: 26rem; }
  /* one sleeve ribbon still touches the painting's right edge (about 70px of it): a narrow feather lets it trail off */
  .about__ed {
    position: relative; z-index: 1; display: block; width: 100%; height: auto;
    mask-image: linear-gradient(to left, transparent, #000 6%);
  }

  /* Cloud tower: retune here (rest position, as % of the figure). The fly-in starts it further left, over Ed. */
  .about__tower {
    position: absolute; z-index: 2; pointer-events: none; height: auto; max-width: none;
    width: 50%; right: -30%; bottom: -2%; opacity: 0.9;
  }

  @media (min-width: 60rem) {
    .about { grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); }
    .about__figure { max-width: none; }
    .about__tower { width: 58%; right: -48%; bottom: -4%; }
  }
  @media (max-width: 48rem) {
    /* phones: tucked top-right beside the heading, clear of the bio */
    :global(.flora.flora--about) { left: auto; right: calc(var(--gutter) * -0.5); top: calc(var(--space-2xl) - 2rem); }
  }
</style>

<script>
  import { initAboutRise } from '../scripts/about-rise';
  const el = document.querySelector<HTMLElement>('[data-about]');
  if (el) initAboutRise(el);
</script>
