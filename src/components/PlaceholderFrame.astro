---
import Lattice from './Lattice.astro';
// Stands in for an image that has not been added yet: a pale porcelain panel with a faint lattice. Decorative.
// In dev it says where the image goes, so the gap is easy to spot and fill from Keystatic.
interface Props { ratio?: string; hint?: string; id: string }
const { ratio = '16 / 10', hint = 'Add an image in Keystatic', id } = Astro.props;
---
<div class="frame" style={`aspect-ratio: ${ratio}`} aria-hidden="true">
  <Lattice id={`frame-${id}`} class="frame__lattice" tile={36} />
  {import.meta.env.DEV && <span class="frame__hint">{hint}</span>}
</div>

<style>
  .frame {
    position: relative; display: grid; place-items: center; width: 100%; overflow: hidden;
    background: var(--surface-brand-soft); outline: 1px solid var(--border-hairline); outline-offset: -8px;
  }
  .frame :global(.frame__lattice) { position: absolute; inset: 0; color: var(--blue-100); }
  .frame__hint {
    position: relative; padding: 6px 12px; font-size: var(--text-xs); font-weight: var(--fw-semibold); letter-spacing: var(--ls-caps);
    text-transform: uppercase; color: var(--text-brand); background: var(--surface-raised); border: 1px dashed var(--border-default);
  }
</style>
