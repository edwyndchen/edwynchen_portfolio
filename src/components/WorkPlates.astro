---
import { getCollection } from 'astro:content';
import Plate from './Plate.astro';
import { sortCaseStudies } from '../lib/case-studies';
const studies = sortCaseStudies(await getCollection('caseStudies'));
---
<section id="work" class="work wrap" aria-labelledby="work-title">
  <h2 id="work-title">Selected work</h2>
  <ol class="work__list">
    {studies.map((s) => (
      <li data-reveal-on-scroll>
        <Plate as="article" class="work__plate">
          {s.data.cover && <div class="work__media"><img class="work__cover" src={s.data.cover} alt="" width="800" height="450" loading="lazy" /></div>}
          <p class="label work__meta">{s.data.discipline === 'design-system' ? 'Design system' : 'Product design'}</p>
          <h3><a href={`/work/${s.id}/`}>{s.data.title}</a></h3>
          <p class="work__outcome">{s.data.outcome}</p>
        </Plate>
      </li>
    ))}
  </ol>
</section>

<style>
  .work { padding-top: var(--space-xl); position: relative; overflow-x: clip; }
  .work h2, .work__list { position: relative; z-index: 1; }
  .work h2 { font-size: var(--step-3); margin-bottom: var(--space-l); }
  .work__list { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--space-l) var(--space-xl); align-items: start; }
  /* two columns, the right one dropped half a step: a catalogue wall, not a tiled grid */
  @media (min-width: 60rem) {
    .work__list { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .work__list { padding-bottom: var(--space-xl); }
    .work__list > li:nth-child(even) { translate: 0 var(--space-xl); }
  }
  /* Plate renders the element, so its passed class needs :global to be styled from here */
  /* hover and focus deepen the inner keyline to cobalt: the plate's rim answers, nothing lifts or zooms */
  .work :global(.work__plate) { position: relative; transition: outline-color var(--dur-med) var(--ease-standard); }
  .work :global(.work__plate:hover), .work :global(.work__plate:focus-within) { outline-color: var(--cobalt); }
  .work__media { overflow: hidden; margin-bottom: var(--space-m); }
  .work__cover { width: 100%; height: auto; mix-blend-mode: multiply; }
  .work__meta { margin-bottom: 0; color: var(--text-secondary); }
  .work h3 { font-size: var(--fluid-display-md); margin: var(--space-xs) 0 var(--space-s); }
  .work h3 a { color: var(--cobalt); text-decoration: none; }
  .work h3 a::after { content: ''; position: absolute; inset: 0; }
  .work :global(.work__plate:hover) h3 a { color: var(--action-primary-hover); }
  .work h3 a:focus-visible { text-decoration: underline; }
  .work__outcome { margin: 0; max-width: 46ch; color: var(--text-secondary); }
  /* focus ring around the whole plate (the stretched link covers it), clear of the double keyline */
  @supports selector(:has(*)) {
    .work h3 a:focus-visible { outline: none; }
    .work :global(.work__plate:has(a:focus-visible)) { box-shadow: 0 0 0 2px var(--porcelain), 0 0 0 4px var(--focus-ring); }
  }
</style>
