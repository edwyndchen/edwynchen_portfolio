---
import { site } from '../data/site';
---
<section class="hero" data-hero aria-labelledby="hero-title">
  <div class="hero__copy wrap">
    <div class="hero__name">
      <h1 id="hero-title" data-reveal>{site.name}</h1>
      <p class="hero__role" data-reveal>Melbourne-based product designer making the world more accessible and beautiful, one screen at a time.</p>
    </div>
    <div class="hero__pitch">
      <a class="button hero__cta" href="#work" data-reveal>View work</a>
    </div>
  </div>
  <div class="hero__scene" aria-hidden="true">
    <div class="hero__layer" data-depth="0.04" data-scroll="0">
      <img class="hero__fill" src="/hero/far.webp" alt="" width="2400" height="1021" decoding="async" fetchpriority="high" />
      <img class="hero__cloud" src="/hero/cloud-s4.webp" alt="" decoding="async" loading="lazy" style="top:44%;left:0;--rest:12%;width:26%" />
      <img class="hero__cloud" src="/hero/cloud-r1.webp" alt="" decoding="async" loading="lazy" style="top:22%;left:0;--rest:60%;width:16%" />
      <img class="hero__cloud" src="/hero/cloud-r4.webp" alt="" decoding="async" loading="lazy" style="top:8%;left:0;--rest:86%;width:13%" />
      <svg class="hero__cross" viewBox="0 0 100 100"><g fill="currentColor">
        <circle cx="50" cy="8" r="4"/><circle cx="44" cy="92" r="4.6"/><circle cx="14" cy="46" r="4"/><circle cx="80" cy="36" r="3.4"/><circle cx="62" cy="62" r="2.2"/>
      </g></svg>
    </div>
    <div class="hero__layer" data-depth="0.12" data-scroll="0.15">
      <img class="hero__cloud" src="/hero/cloud-r2.webp" alt="" decoding="async" loading="lazy" style="top:12%;left:0;--rest:30%;width:15%" />
      <img class="hero__cloud" src="/hero/cloud-s2.webp" alt="" decoding="async" loading="lazy" style="top:32%;left:0;--rest:78%;width:14%" />
      <img class="hero__cloud" src="/hero/cloud-r3.webp" alt="" decoding="async" loading="lazy" style="top:40%;left:0;--rest:36%;width:12%" />
    </div>
    <div class="hero__layer" data-depth="0.22" data-scroll="0.3">
      <img class="hero__fill" src="/hero/peaks.webp" alt="" width="2400" height="1021" decoding="async" />
    </div>
    <div class="hero__layer" data-depth="0.29" data-scroll="0.38">
      <img class="hero__fill" src="/hero/peaks-front.webp" alt="" width="2400" height="1021" decoding="async" />
    </div>
    <div class="hero__layer" data-depth="0.35" data-scroll="0.45">
      <img class="hero__cloud" src="/hero/cloud-s1.webp" alt="" decoding="async" loading="lazy" style="top:54%;left:0;--rest:8%;width:20%" />
      <img class="hero__cloud" src="/hero/cloud-r4.webp" alt="" decoding="async" loading="lazy" style="top:58%;left:0;--rest:55%;width:13%" />
    </div>
    <div class="hero__layer" data-depth="0.5" data-scroll="0.65">
      <img class="hero__fill" src="/hero/mid.webp" alt="" width="2400" height="1021" decoding="async" />
      <img class="hero__tram" data-tram src="/hero/tram.webp" alt="" decoding="async" />
    </div>
    <div class="hero__layer" data-depth="1" data-scroll="1.1">
      <img class="hero__cloud" src="/hero/cloud-s3.webp" alt="" decoding="async" loading="lazy" style="top:3%;left:0;--rest:2%;width:20%" />
      <img class="hero__cloud" src="/hero/cloud-s2.webp" alt="" decoding="async" loading="lazy" style="top:12%;left:0;--rest:40%;width:18%" />
      <img class="hero__cloud" src="/hero/cloud-r3.webp" alt="" decoding="async" loading="lazy" style="top:22%;left:0;--rest:74%;width:15%" />
    </div>
  </div>
</section>

<style>
  .hero { overflow: clip; }
  .hero__copy {
    display: grid; gap: var(--space-m) var(--space-xl); align-items: end;
    padding-top: clamp(2.5rem, 7vh, 6rem); padding-bottom: clamp(1.5rem, 4vh, 3rem);
  }
  /* one column: name, the line, then the button under it */
  .hero__copy { justify-items: start; }
  .hero h1 { font-size: var(--step-4); max-width: 12ch; }
  /* the role reads as a quiet serif subtitle, the DS italic voice, one size under the section headings */
  .hero__role {
    font-family: var(--font-display); font-style: italic; font-weight: var(--fw-medium);
    font-size: var(--fluid-display-md); line-height: var(--lh-snug); color: var(--ink);
    max-width: 30ch; margin: var(--space-s) 0 0;
  }
  .hero__pitch { padding-bottom: 0.4em; }
  @media (min-width: 60rem) { .hero__pitch { margin-top: var(--space-s); } }
  .hero__cta::after { content: '\2193'; font-weight: 400; transition: transform var(--dur-med) var(--ease-standard); }
  .hero__cta:hover::after { transform: translateY(2px); }

  .hero__scene {
    /* 16% extra sky above the painting so layers spread upward on load never get their peaks cut flat */
    position: relative; width: 100%; aspect-ratio: 3120 / 1540; overflow: hidden; background: var(--porcelain);
    /* the art's paper edge dissolves into the glaze instead of ending on a hard line */
    /* (a long top fade, so the cooler sky never meets the paper on a visible line) */
    -webkit-mask-image: linear-gradient(to bottom, transparent, var(--cobalt-ink) 18%, var(--cobalt-ink) 94%, transparent);
    mask-image: linear-gradient(to bottom, transparent, var(--cobalt-ink) 18%, var(--cobalt-ink) 94%, transparent);
  }
  /* layers keep the painting's aspect, sit on the bottom of the scene and are slightly oversized so parallax never reveals an edge */
  .hero__layer { position: absolute; inset: auto -3% -3% -3%; height: 91.4%; /* 106% width at the painting aspect, inside the 1540-tall scene */ will-change: transform; }
  .hero__fill { position: absolute; inset: 0; width: 100%; height: 100%; display: block; }
  .hero__cloud { position: absolute; height: auto; }
  .hero__tram { position: absolute; left: 31%; top: 77%; width: 3.6%; height: auto; opacity: 0; }
  .hero__cross { position: absolute; top: 6%; left: 46%; width: 3%; color: #B8862B; /* artwork keeps its painted gold */ opacity: 0.8; }
  @media (prefers-reduced-motion: reduce) { .hero__tram { opacity: 1; left: 47%; } .hero__cloud { left: var(--rest) !important; /* beats inline left:0 */ } }
  @media (max-width: 48rem) {
    /* Layers keep the art's aspect (2400/1021) and overflow the scene, so %-positioned items stay on
       the artwork. 144% wide, shifted 27% left, frames the Spire (~21-29% across the art) through the
       Flinders Street clock tower (~88%). Scene aspect 1.49 adds the same 16% sky headroom as desktop. */
    .hero__scene { aspect-ratio: 1.49; }
    .hero__layer { inset: auto; bottom: -3%; height: 91.3%; width: 144%; left: -27%; }
    .hero__cloud ~ .hero__cloud ~ .hero__cloud { display: none; }
  }
</style>

<script>
  import { initHero } from '../scripts/hero-motion';
  const el = document.querySelector<HTMLElement>('[data-hero]');
  if (el) initHero(el);
</script>
