---
import { site } from '../data/site';
---
<section class="hero" data-hero aria-labelledby="hero-title">
  <div class="hero__copy wrap">
    <div class="hero__name">
      <h1 id="hero-title" data-reveal>{site.name}</h1>
      <p class="hero__role" data-reveal>Melbourne-based product designer making the world more accessible and beautiful, one screen at a time.</p>
    </div>
    <div class="hero__pitch">
      <a class="button hero__cta" href="#work" data-reveal>View work</a>
    </div>
  </div>
  <div class="hero__scene" aria-hidden="true">
    <!-- the furthest range: starts highest, and flattens down to the city's level as you scroll (round 9) -->
    <div class="hero__layer hero__layer--back" data-depth="0.04" data-scroll="0.05">
      <img class="hero__fill" src="/hero/far.webp" srcset="/hero/far-1200.webp 1200w, /hero/far-1800.webp 1800w, /hero/far.webp 2400w" sizes="(max-width: 48rem) 144vw, 106vw" alt="" width="2400" height="1021" decoding="async" fetchpriority="high" />
      <img class="hero__cloud" src="/hero/cloud-s4.webp" alt="" decoding="async" loading="lazy" style="top:44%;left:0;--rest:12%;width:18%" />
      <img class="hero__cloud" src="/hero/cloud-r1.webp" alt="" decoding="async" loading="lazy" style="top:24%;left:0;--rest:58%;width:17%" />
      <img class="hero__cloud" src="/hero/cloud-r4.webp" alt="" decoding="async" loading="lazy" style="top:8%;left:0;--rest:86%;width:10%" />
    </div>
    <div class="hero__layer" data-depth="0.12" data-scroll="0.15">
      <img class="hero__cloud" src="/hero/cloud-r2.webp" alt="" decoding="async" loading="lazy" style="top:12%;left:0;--rest:30%;width:15%" />
      <img class="hero__cloud" src="/hero/cloud-v6.webp" alt="" decoding="async" loading="lazy" style="top:30%;left:0;--rest:76%;width:15%" />
      <img class="hero__cloud" src="/hero/cloud-r3.webp" alt="" decoding="async" loading="lazy" style="top:40%;left:0;--rest:36%;width:12%" />
    </div>
    <div class="hero__layer" data-depth="0.22" data-scroll="0.3">
      <img class="hero__fill" src="/hero/peaks.webp" srcset="/hero/peaks-1200.webp 1200w, /hero/peaks-1800.webp 1800w, /hero/peaks.webp 2400w" sizes="(max-width: 48rem) 144vw, 106vw" alt="" width="2400" height="1021" decoding="async" />
    </div>
    <div class="hero__layer" data-depth="0.29" data-scroll="0.38">
      <img class="hero__fill" src="/hero/peaks-front.webp" srcset="/hero/peaks-front-1200.webp 1200w, /hero/peaks-front-1800.webp 1800w, /hero/peaks-front.webp 2400w" sizes="(max-width: 48rem) 144vw, 106vw" alt="" width="2400" height="1021" decoding="async" />
    </div>
    <div class="hero__layer" data-depth="0.35" data-scroll="0.45">
      <img class="hero__cloud" src="/hero/cloud-s1.webp" alt="" decoding="async" loading="lazy" style="top:54%;left:0;--rest:8%;width:20%" />
      <img class="hero__cloud" src="/hero/cloud-s2.webp" alt="" decoding="async" loading="lazy" style="top:58%;left:0;--rest:52%;width:22%" />
    </div>
    <div class="hero__layer" data-depth="0.5" data-scroll="0.65">
      <img class="hero__fill" src="/hero/mid.webp" srcset="/hero/mid-1200.webp 1200w, /hero/mid-1800.webp 1800w, /hero/mid.webp 2400w" sizes="(max-width: 48rem) 144vw, 106vw" alt="" width="2400" height="1021" decoding="async" />
      <img class="hero__tram" data-tram src="/hero/tram.webp" alt="" decoding="async" />
    </div>
    <div class="hero__layer" data-depth="1" data-scroll="1.1">
      <img class="hero__cloud" src="/hero/cloud-s3.webp" alt="" decoding="async" loading="lazy" style="top:3%;left:0;--rest:2%;width:20%" />
      <img class="hero__cloud" src="/hero/cloud-v5.webp" alt="" decoding="async" loading="lazy" style="top:12%;left:0;--rest:40%;width:17%" />
      <img class="hero__cloud" src="/hero/cloud-r3.webp" alt="" decoding="async" loading="lazy" style="top:22%;left:0;--rest:74%;width:15%" />
    </div>
  </div>
</section>

<style>
  .hero { overflow: clip; }
  .hero__copy {
    display: grid; gap: var(--space-m) var(--space-xl); align-items: end;
    padding-top: clamp(2.5rem, 7vh, 6rem); padding-bottom: clamp(1.5rem, 4vh, 3rem);
  }
  /* one column: name, the line, then the button under it */
  .hero__copy { justify-items: start; }
  /* the name in the logo's family, Poppins SemiBold with just a touch of air between the letters (Ed: 0.03em in round 9,
     0.01em in round 10) */
  .hero h1 { font-family: var(--font-wordmark); font-weight: 600; letter-spacing: 0.01em; font-size: var(--fluid-display-xl); max-width: 12ch; }
  /* the role reads as a quiet serif subtitle, the DS italic voice, one size under the section headings */
  .hero__role {
    font-family: var(--font-display); font-style: italic; font-weight: var(--fw-medium);
    font-size: var(--fluid-display-sm); line-height: var(--lh-snug); color: var(--ink);
    max-width: 30ch; margin: var(--space-s) 0 0;
  }
  .hero__pitch { padding-bottom: 0.4em; }
  @media (min-width: 60rem) { .hero__pitch { margin-top: var(--space-s); } }
  .hero__cta::after { content: '\2193'; font-weight: 400; transition: transform var(--dur-med) var(--ease-standard); }
  .hero__cta:hover::after { transform: translateY(2px); }

  .hero__scene {
    /* 16% extra sky above the painting so layers spread upward on load never get their peaks cut flat */
    /* clipped at the sides only: at the top of the page the back layers stand high and may rise past the scene's
       top edge, so nothing is ever cut flat (Ed, round 9). No background and no mask (a mask would hide whatever
       rises above the box): the page shows through, and only the foot dissolves, under an overlay (::after). The far
       range carries its own soft top edge. */
    position: relative; width: 100%; aspect-ratio: 3120 / 1540; overflow-x: clip; overflow-y: visible;
  }
  .hero__scene::after {
    content: ''; position: absolute; inset: auto 0 0; height: 7%; z-index: 20; pointer-events: none;
    background: linear-gradient(to bottom, color-mix(in srgb, var(--porcelain) 0%, transparent), var(--porcelain));
  }
  /* the copy stays above anything that rises behind it */
  .hero__copy { position: relative; z-index: 21; }
  /* layers keep the painting's aspect, sit on the bottom of the scene and are slightly oversized so parallax never reveals an edge */
  .hero__layer { position: absolute; inset: auto -3% -3% -3%; height: 91.4%; /* 106% width at the painting aspect, inside the 1540-tall scene */ will-change: transform; }
  .hero__fill { position: absolute; inset: 0; width: 100%; height: 100%; display: block; }
  /* the far range's painted sky is a touch whiter than the page: its top edge feathers away, so no line ever shows
     between the copy and the mountains */
  .hero__layer--back .hero__fill {
    /* only the blank paper above its peaks feathers away; the peaks themselves start at ~22% of the painting */
    -webkit-mask-image: linear-gradient(to bottom, transparent, #000 17%);
    mask-image: linear-gradient(to bottom, transparent, #000 17%);
  }
  .hero__cloud { position: absolute; height: auto; }
  .hero__tram { position: absolute; left: 31%; top: 77%; width: 3.6%; height: auto; opacity: 0; }
  @media (prefers-reduced-motion: reduce) { .hero__tram { opacity: 1; left: 47%; } .hero__cloud { left: var(--rest) !important; /* beats inline left:0 */ } }
  @media (max-width: 48rem) {
    /* Layers keep the art's aspect (2400/1021) and overflow the scene, so %-positioned items stay on
       the artwork. 144% wide, shifted 27% left, frames the Spire (~21-29% across the art) through the
       Flinders Street clock tower (~88%). Scene aspect 1.49 adds the same 16% sky headroom as desktop. */
    .hero__scene { aspect-ratio: 1.49; }
    .hero__layer { inset: auto; bottom: -3%; height: 91.3%; width: 144%; left: -27%; }
    .hero__cloud ~ .hero__cloud ~ .hero__cloud { display: none; }
    /* two of the cloud-only layers go on phones (round 10: fewer full-width layers to composite while scrolling); the
       far clouds and the front clouds stay */
    .hero__layer[data-depth="0.12"], .hero__layer[data-depth="0.35"] { display: none; }
  }
</style>

<script>
  import { initHero } from '../scripts/hero-motion';
  const el = document.querySelector<HTMLElement>('[data-hero]');
  if (el) initHero(el);
</script>
