---
import Logo from './Logo.astro';
import { site } from '../data/site';
const here = Astro.url.pathname;
---
<header class="nav" data-nav>
  <div class="wrap nav__inner">
    <a class="nav__brand" href="/" aria-label={`${site.name}, home`}>
      <Logo class="nav__logo" />
      <Logo mark class="nav__mark" />
    </a>
    <nav aria-label="Main">
      <ul class="nav__links">
        {site.nav.map((item) => (
          <li><a class="label" href={item.href} aria-current={!item.href.includes('#') && here.startsWith(item.href) ? 'page' : undefined}>{item.label}</a></li>
        ))}
      </ul>
    </nav>
  </div>
</header>

<style>
  /* DS nav: transparent over the top of the page, gains the ivory backing and a hairline once scrolled */
  .nav {
    position: sticky; top: 0; z-index: 50;
    background: transparent;
    border-bottom: 1px solid transparent;
    transition: background-color var(--dur-med) var(--ease-standard), border-color var(--dur-med) var(--ease-standard);
  }
  .nav.is-scrolled { background: var(--surface-page); border-bottom-color: var(--border-hairline); }
  .nav__inner { display: flex; align-items: center; justify-content: space-between; gap: var(--space-4); min-height: 4.5rem; }
  .nav__brand { display: inline-flex; align-items: center; min-height: 44px; color: var(--text-brand); }
  .nav__brand:hover { color: var(--action-primary-hover); }
  .nav__links { display: flex; gap: clamp(1rem, 3vw, 2.5rem); list-style: none; margin: 0; padding: 0; }
  .nav__links a {
    display: inline-flex; align-items: center; justify-content: center; min-height: 44px; min-width: 44px;
    color: var(--text-brand); text-decoration: none;
  }
  .nav__links a:hover { color: var(--action-primary-hover); }
  .nav__links a:active { color: var(--action-primary-active); }
  .nav__links a[aria-current='page'] { text-decoration: underline; text-underline-offset: 0.45em; text-decoration-thickness: 1px; }
  .nav__brand :global(.nav__mark) { display: none; }
  /* phones: four links leave no room for the wordmark, so the brush mark stands in for it */
  @media (max-width: 34rem) {
    .nav__brand :global(.nav__logo) { display: none; }
    .nav__brand :global(.nav__mark) { display: block; height: 26px; }
    .nav__links { gap: 0.75rem; }
  }
  /* small phones (320-415px): tighten so the mark + four links never overflow */
  @media (max-width: 26rem) {
    .nav__links { gap: 0.25rem; }
    .nav__links a { letter-spacing: 0.04em; min-width: 44px; padding-inline: 2px; }
  }
</style>

<script>
  const nav = document.querySelector<HTMLElement>('[data-nav]');
  if (nav) {
    const update = () => nav.classList.toggle('is-scrolled', window.scrollY > 8);
    update();
    window.addEventListener('scroll', update, { passive: true });
  }
</script>
