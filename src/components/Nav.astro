---
import Logo from './Logo.astro';
import { site } from '../data/site';
const here = Astro.url.pathname;
const inWorkshop = here.startsWith(site.workshop.href);
---
<header class="nav" data-nav>
  <div class="wrap nav__inner">
    <a class="nav__brand" href="/" aria-label={`${site.name}, home`}>
      <Logo class="nav__logo" />
      <Logo mark class="nav__mark" />
    </a>
    <nav class="nav__main" aria-label="Main">
      <!-- phones: the page links fold behind this button (a disclosure); from 40rem up they sit in a row -->
      <button class="nav__menu label" type="button" aria-expanded="false" aria-controls="nav-links" data-nav-menu>Menu</button>
      <ul class="nav__links" id="nav-links">
        {site.nav.map((item) => <li><a class="label" href={item.href}>{item.label}</a></li>)}
      </ul>
      <span class="nav__rule" aria-hidden="true"></span>
      <a class="nav__workshop label" href={site.workshop.href} aria-current={inWorkshop ? 'page' : undefined}>{site.workshop.label}</a>
    </nav>
  </div>
</header>

<style>
  /* DS nav: transparent over the top of the page, gains the ivory backing and a hairline once scrolled */
  .nav {
    position: sticky; top: 0; z-index: 50;
    background: transparent;
    border-bottom: 1px solid transparent;
    transition: background-color var(--dur-med) var(--ease-standard), border-color var(--dur-med) var(--ease-standard);
  }
  .nav.is-scrolled, .nav.is-open { background: var(--surface-page); border-bottom-color: var(--border-hairline); }
  .nav__inner { display: flex; align-items: center; justify-content: space-between; gap: var(--space-4); min-height: 4.5rem; }
  .nav__brand { display: inline-flex; align-items: center; min-height: 44px; color: var(--text-brand); }
  .nav__brand:hover { color: var(--action-primary-hover); }
  .nav__brand :global(.nav__mark) { display: none; }
  .nav__main { display: flex; align-items: center; gap: clamp(1rem, 3vw, 2.5rem); }
  .nav__links { display: flex; gap: clamp(1rem, 3vw, 2.5rem); list-style: none; margin: 0; padding: 0; }
  .nav__links a, .nav__menu {
    display: inline-flex; align-items: center; justify-content: center; min-height: 44px; min-width: 44px;
    color: var(--text-brand); text-decoration: none;
  }
  .nav__links a:hover { color: var(--action-primary-hover); }
  .nav__links a:active { color: var(--action-primary-active); }
  /* a hairline between the page links and the Workshop, which is a place of its own */
  .nav__rule { width: 1px; height: 1.25rem; background: var(--border-default); }
  /* DS secondary button, compact: the Workshop door */
  .nav__workshop {
    display: inline-flex; align-items: center; min-height: 40px; padding: 0 var(--space-s);
    color: var(--text-brand); text-decoration: none; border: 1px solid var(--border-strong);
    transition: background-color var(--dur-med) var(--ease-standard), color var(--dur-med) var(--ease-standard);
  }
  .nav__workshop:hover { background: var(--surface-brand-soft); color: var(--action-primary-hover); }
  .nav__workshop[aria-current='page'] { background: var(--action-primary); border-color: var(--action-primary); color: var(--text-on-brand); }
  .nav__menu { display: none; background: none; border: 0; padding: 0 var(--space-2); font: inherit; cursor: pointer; }
  .nav__menu::after { content: ''; width: 0.5rem; height: 0.5rem; margin-left: 0.5rem; border: solid currentColor; border-width: 0 1.5px 1.5px 0; translate: 0 -2px; rotate: 45deg; transition: rotate var(--dur-med) var(--ease-standard); }
  .nav__menu[aria-expanded='true']::after { rotate: 225deg; translate: 0 2px; }

  /* phones: brush mark, Menu and the Workshop button; the page links drop down under the bar */
  @media (max-width: 39.99rem) {
    .nav__brand :global(.nav__logo) { display: none; }
    .nav__brand :global(.nav__mark) { display: block; height: 26px; }
    .nav__main { gap: var(--space-s); }
    .nav__rule { display: none; }
    .nav__menu { display: inline-flex; order: 1; }
    .nav__workshop { order: 2; }
    :global(.js) .nav__links {
      position: absolute; inset: 100% 0 auto 0; flex-direction: column; gap: 0;
      padding: var(--space-2) var(--gutter) var(--space-m); background: var(--surface-page); border-bottom: 1px solid var(--border-hairline);
    }
    :global(.js) .nav__links:not(.is-open) { display: none; }
    :global(.js) .nav__links a { justify-content: flex-start; width: 100%; min-height: 48px; border-top: 1px solid var(--border-hairline); }
    /* without JS there is no menu to open: the links stay in the bar, tightened */
    :global(html:not(.js)) .nav__menu { display: none; }
    :global(html:not(.js)) .nav__links { gap: var(--space-2); }
  }
</style>

<script>
  const nav = document.querySelector<HTMLElement>('[data-nav]');
  if (nav) {
    const update = () => nav.classList.toggle('is-scrolled', window.scrollY > 8);
    update();
    window.addEventListener('scroll', update, { passive: true });

    // phone menu: a disclosure button; Escape or choosing a link closes it, focus returns to the button on Escape
    const button = nav.querySelector<HTMLButtonElement>('[data-nav-menu]');
    const list = nav.querySelector<HTMLElement>('#nav-links');
    if (button && list) {
      const set = (open: boolean) => {
        button.setAttribute('aria-expanded', String(open));
        list.classList.toggle('is-open', open);
        nav.classList.toggle('is-open', open);
      };
      button.addEventListener('click', () => set(button.getAttribute('aria-expanded') !== 'true'));
      list.addEventListener('click', (e) => { if ((e.target as Element).closest('a')) set(false); });
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && button.getAttribute('aria-expanded') === 'true') { set(false); button.focus(); }
      });
      document.addEventListener('click', (e) => { if (!nav.contains(e.target as Node)) set(false); });
    }
  }
</script>
