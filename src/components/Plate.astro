---
interface Props { as?: string; class?: string }
const { as: Tag = 'div', class: className } = Astro.props;
---
<Tag class:list={['plate', className]}>
  <slot />
</Tag>

<style>
  /* DS card: white porcelain body, square corners, clean double keyline (cobalt outer, soft inner), soft cool shadow */
  .plate {
    position: relative;
    border: var(--rule);
    outline: 1px solid var(--border-default);
    outline-offset: -7px;
    border-radius: var(--radius-card);
    padding: clamp(1.5rem, 1rem + 2vw, 2.75rem);
    background: var(--surface-raised);
    box-shadow: var(--shadow-sm);
  }
</style>
