---
import { site } from '../data/site';
import SocialIcon from './SocialIcon.astro';
import SealStamp from './SealStamp.astro';
---
<section id="contact" class="contact wrap" aria-labelledby="contact-title" data-scroll-paint>
  <!-- the invitation and the ways to reach Ed, above the scroll -->
  <!-- the invitation and how to play, above the scroll -->
  <div class="contact__head">
    <h2 id="contact-title">Let’s make something beautiful together.</h2>
    <ol class="paint__steps" aria-label="How to paint the scroll">
      <li data-step-item="paint"><span class="paint__num" aria-hidden="true">1</span>Paint the scene with the brush</li>
      <li data-step-item="pig"><span class="paint__num" aria-hidden="true">2</span>Add a flying pig</li>
      <li data-step-item="seal"><span class="paint__num" aria-hidden="true">3</span>Sign it with my seal</li>
    </ol>
  </div>

  <!-- a hanging scroll to paint on (scroll-paint.ts): the scene, then a flying pig, then Ed's seal -->
  <div class="scroll">
    <span class="scroll__rod" aria-hidden="true"></span>
    <div class="scroll__mount">
      <div class="scroll__paper" data-paint>
        <p class="visually-hidden" id="paint-help">A painting to make: paint the scene with your pointer or finger, add a flying pig, then sign it with Edwyn's seal. Each step also has a button.</p>
        <div class="paint__art" aria-hidden="true">
          <img class="paint__sketch" src="/scroll/apostles-sketch.webp" alt="" data-paint-sketch />
          <canvas class="paint__canvas" data-paint-canvas></canvas>
        </div>
        <div class="scroll__stamps" aria-hidden="true" data-stamps></div>
        <img class="paint__brush" src="/scroll/brush.webp" alt="" width="200" height="242" aria-hidden="true" loading="lazy" decoding="async" data-brush />
        <img class="scroll__seal" src="/scroll/seal.webp" alt="" width="220" height="537" aria-hidden="true" loading="lazy" decoding="async" data-seal />
        <template data-stamp-tpl><span class="scroll__stamp"><SealStamp /></span></template>

      </div>
    </div>
    <span class="scroll__rod" aria-hidden="true"></span>
  </div>
  <!-- the prompt and the step buttons sit under the scroll, off the painting -->
  <div class="paint__bar" data-paint-ui>
    <p class="paint__prompt" role="status" aria-describedby="paint-help" data-paint-prompt>Pick up the brush and paint the Twelve Apostles.</p>
    <div class="paint__buttons">
      <button class="button" type="button" data-paint-action="auto">Paint it for me</button>
      <button class="button" type="button" data-paint-action="pig" hidden>Add a flying pig</button>
      <button class="button" type="button" data-paint-action="seal" hidden>Add the seal</button>
      <button class="button paint__quiet" type="button" data-paint-action="reset">Start again</button>
      <button class="paint__next" type="button" data-paint-action="next" aria-label="Next scene: Wilsons Promontory">Next scene
        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M9 5l7 7-7 7" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>
      </button>
    </div>
  </div>
  <!-- then the real thing: the ways to reach Ed -->
  <div class="contact__foot">
    <p class="contact__more">Contact me to make more beautiful work together.</p>
      <ul class="contact__links">
        <li><a href={`mailto:${site.email}`} aria-label={`Email ${site.email}`} title={site.email}><SocialIcon name="mail" /></a></li>
        {site.linkedin && <li><a href={site.linkedin} rel="me noopener" target="_blank" aria-label="LinkedIn (opens in a new tab)" title="LinkedIn"><SocialIcon name="linkedin" /></a></li>}
        {site.behance && <li><a href={site.behance} rel="me noopener" target="_blank" aria-label="Behance (opens in a new tab)" title="Behance"><SocialIcon name="behance" /></a></li>}
        {site.resume && <li><a class="contact__resume" href={site.resume}>Resume</a></li>}
      </ul>
  </div>
</section>

<style>
  .contact { padding-top: var(--space-xl); padding-bottom: var(--space-2xl); }
  .contact__head { display: grid; gap: var(--space-m); margin-bottom: var(--space-l); }
  .contact h2 { font-size: var(--step-3); max-width: 22ch; margin: 0; }
  /* the three steps; the current one is marked as the visitor goes (scroll-paint.ts sets data-step on the section) */
  .paint__steps { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: var(--space-xs) var(--space-l); }
  .paint__steps li { display: inline-flex; align-items: center; gap: var(--space-xs); color: var(--text-secondary); font-size: var(--text-md); }
  .paint__num {
    display: inline-grid; place-items: center; width: 28px; height: 28px; border-radius: 50%; flex: none;
    border: 1px solid var(--border-default); font-size: var(--text-sm); font-weight: var(--fw-semibold); color: var(--text-brand);
  }
  [data-step='paint'] [data-step-item='paint'], [data-step='pig'] [data-step-item='pig'], [data-step='seal'] [data-step-item='seal'] { color: var(--text-brand); font-weight: var(--fw-semibold); }
  [data-step='paint'] [data-step-item='paint'] .paint__num, [data-step='pig'] [data-step-item='pig'] .paint__num, [data-step='seal'] [data-step-item='seal'] .paint__num { background: var(--action-primary); color: var(--text-on-brand); border-color: var(--action-primary); }
  .contact__foot { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: var(--space-m) var(--space-l); margin-top: var(--space-xl); padding-top: var(--space-l); border-top: var(--rule-hair); }
  .contact__more { margin: 0; font-family: var(--font-display); font-size: var(--fluid-display-sm); color: var(--text-brand); max-width: 30ch; }
  .contact__links { list-style: none; padding: 0; margin: 0; display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-s); }
  /* 48px round targets holding a 26px icon, ringed in cobalt like a porcelain seal */
  .contact__links a {
    display: inline-flex; align-items: center; justify-content: center; width: 48px; height: 48px; font-size: 26px;
    border: 1px solid var(--border-default); border-radius: 50%; color: var(--text-brand); background: var(--surface-raised);
    transition: background var(--dur-med) var(--ease-standard), color var(--dur-med) var(--ease-standard), border-color var(--dur-med) var(--ease-standard);
  }
  .contact__links a:hover { background: var(--action-primary); color: var(--text-on-brand); border-color: var(--action-primary); }
  .contact__links a:focus-visible { outline: 2px solid var(--focus-ring); outline-offset: 3px; }
  .contact__links .contact__resume { width: auto; padding-inline: var(--space-s); border-radius: 24px; font-size: var(--text-sm); font-weight: var(--fw-semibold); }

  /* the scroll: rods wider than the paper, with knobbed ends; a pale silk mount; the paper itself */
  .scroll { position: relative; --rod-h: 34px; }
  /* rods painted in the art's own cobalt brushwork (npm run scroll): a lotus cap and patterned band at each end, the
     plain shaft repeating between them. The knob sprite is 149x96, so --knob = height * 1.55. */
  .scroll__rod {
    --knob: 53px;
    display: block; position: relative; z-index: 2; height: var(--rod-h); margin-inline: calc(var(--knob) * -0.5);
    padding-inline: calc(var(--knob) - 2px);
    background:
      url(/scroll/rod-left.webp) left center / auto 100% no-repeat,
      url(/scroll/rod-right.webp) right center / auto 100% no-repeat,
      url(/scroll/rod-mid.webp) center / auto 100% repeat-x;
    background-clip: border-box, border-box, content-box;
    background-origin: border-box, border-box, content-box;
  }
  /* the silk tucks under each rod to the middle of the shaft, so no strip of page shows between them */
  .scroll__rod:first-child { margin-bottom: calc(var(--rod-h) * -0.5); }
  .scroll__rod:last-child { margin-top: calc(var(--rod-h) * -0.5); }
  .scroll__mount { position: relative; z-index: 1; padding: calc(12px + var(--rod-h) * 0.5) 12px; background: var(--blue-50); border-inline: 1px solid var(--border-default); }
  /* glaze-white paper with a fine cobalt keyline; a fixed shape so the painting always fits */
  .scroll__paper {
    position: relative; overflow: hidden; aspect-ratio: 2 / 1; background: var(--paper-0);
    box-shadow: inset 0 0 0 1px var(--border-default), inset 0 0 0 5px var(--paper-0), inset 0 0 0 6px var(--border-hairline);
  }
  /* the painting area sits inside the inner keyline with a margin; its ends and foot fade into the paper */
  .paint__art { position: absolute; inset: 18px; }
  .paint__canvas, .paint__sketch { position: absolute; }
  .paint__canvas {
    inset: 0; width: 100%; height: 100%; touch-action: pan-y; /* horizontal strokes paint; a vertical swipe still scrolls the page */
    -webkit-mask-image: linear-gradient(to right, transparent, #000 6%, #000 94%, transparent), linear-gradient(to top, transparent, #000 10%);
    mask-image: linear-gradient(to right, transparent, #000 6%, #000 94%, transparent), linear-gradient(to top, transparent, #000 10%);
    -webkit-mask-composite: source-in; mask-composite: intersect;
  }
  /* the skeleton of the scene breathes slowly until the first stroke */
  .paint__sketch { opacity: 0.35; animation: paint-breathe 3.2s ease-in-out infinite; transition: opacity 1s var(--ease-standard); pointer-events: none; }
  .paint__sketch.is-gone { animation: none; opacity: 0; }
  @keyframes paint-breathe { 50% { opacity: 0.08; } }
  @media (prefers-reduced-motion: reduce) { .paint__sketch { animation: none; } }
  :global(html.motion-paused) .paint__sketch { animation: none; }
  /* while painting, the painted brush follows the pointer in place of the cursor (scroll-paint.ts) */
  .paint__brush { position: absolute; left: 0; top: 0; z-index: 5; width: 110px; height: auto; opacity: 0; pointer-events: none; will-change: transform; }
  .scroll__paper.is-painting, .scroll__paper.is-painting .paint__canvas { cursor: none; }

  /* under the scroll: the prompt on the left, the step buttons and the next-scene arrow on the right */
  .paint__bar { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: var(--space-s) var(--space-m); margin-top: var(--space-m); }
  .paint__prompt { margin: 0; font-family: var(--font-display); font-style: italic; font-size: var(--fluid-display-sm); color: var(--text-brand); max-width: 30ch; }
  .paint__buttons { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-xs); }
  .paint__buttons [hidden] { display: none; }
  .paint__quiet { background: var(--surface-raised); }
  .paint__next {
    display: inline-flex; align-items: center; gap: 0.4rem; min-height: 48px; padding: 0 0.9rem 0 1.1rem; border: 1px solid var(--border-strong);
    border-radius: 24px; background: var(--surface-raised); color: var(--text-brand); cursor: pointer; font: inherit; font-size: var(--text-sm); font-weight: var(--fw-semibold);
  }
  .paint__next:hover { background: var(--action-primary); color: var(--text-on-brand); }
  .paint__next:focus-visible { outline: 2px solid var(--focus-ring); outline-offset: 3px; }
  .paint__next svg { width: 20px; height: 20px; }

  /* the seal and its impression: the seal floats above everything; the red mark sits on the paper, fully opaque */
  .scroll__stamps { position: absolute; inset: 0; z-index: 3; pointer-events: none; }
  .scroll__stamp { position: absolute; width: clamp(64px, 7vw, 96px); aspect-ratio: 1; }
  .scroll__seal { position: absolute; left: 0; top: 0; z-index: 5; width: 52px; height: auto; opacity: 0; pointer-events: none; will-change: transform; }
  .scroll__paper.is-sealing, .scroll__paper.is-sealing .paint__canvas { cursor: none; }

  @media (max-width: 47.99rem) {
    .scroll { --rod-h: 25px; }
    .scroll__rod { --knob: 39px; margin-inline: calc(var(--knob) * -0.3); }
    .scroll__mount { padding: calc(8px + var(--rod-h) * 0.5) 8px; }
    /* phones: a taller sheet so the scene keeps its size */
    .scroll__paper { aspect-ratio: 1.4; }
  }
</style>

<script>
  import { initScrollPaint } from '../scripts/scroll-paint';
  const root = document.querySelector<HTMLElement>('[data-scroll-paint]');
  if (root) initScrollPaint(root);
</script>
