---
import SouthernCross from './SouthernCross.astro';
import { site } from '../data/site';
const year = new Date().getFullYear();
---
<footer class="footer">
  <div class="wrap footer__inner">
    <p class="label">© {year} {site.name}</p>
    <p class="footer__made">
      Made in Melbourne
      <SouthernCross class="footer__cross" />
    </p>
  </div>
</footer>

<style>
  .footer { border-top: var(--rule-soft); padding-block: var(--space-m); }
  .footer__inner { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: var(--space-xs) var(--space-m); }
  .footer p { margin: 0; }
  .footer__made { display: inline-flex; align-items: center; gap: 0.5rem; font-size: var(--step--1); white-space: nowrap; }
  /* the svg is rendered by SouthernCross, so the class needs :global to reach it */
  .footer :global(.footer__cross) { width: 1.6rem; height: 1.6rem; color: var(--wattle-gold); flex: none; }
</style>
