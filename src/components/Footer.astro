---
import SealStamp from './SealStamp.astro';
import Logo from './Logo.astro';
import { site } from '../data/site';
const year = new Date().getFullYear();
---
<footer class="footer">
  <div class="wrap footer__main">
    <div class="footer__about">
      <!-- the logo and Ed's seal share a line (Ed, round 12), so the links below fit one line on a phone -->
      <div class="footer__brandrow">
        <a class="footer__brand" href="/" aria-label={`${site.name}, home`}><Logo /></a>
        <span class="footer__seal"><SealStamp id="seal-footer" title={`${site.name}'s seal`} /></span>
      </div>
      <p class="footer__summary">{site.summary}</p>
    </div>
  </div>
  <div class="wrap footer__base">
    <p class="label">© {year} {site.name}</p>
    <ul class="footer__legal">
      <li><a href="/privacy/">Privacy policy</a></li>
      <li><a href="/terms/">Terms of use</a></li>
      <li class="footer__end"><button class="footer__top" type="button" data-back-to-top>Back to top<svg viewBox="0 0 16 16" aria-hidden="true" focusable="false"><path d="M8 13V3M3.5 7.5L8 3l4.5 4.5" /></svg></button></li>
    </ul>
  </div>
</footer>
<!-- Acknowledgement of Country: its own band beneath the footer, with the flags -->
<aside class="country" aria-labelledby="country-title">
  <div class="wrap country__inner">
    <ul class="country__flags" aria-label="Flags">
      <li><img src="/flags/aboriginal.svg" alt="Australian Aboriginal flag" width="72" height="36" /></li>
      <!-- copyright: Torres Strait Island Regional Council; shown here as part of the Acknowledgement -->
      <li><img src="/flags/torres-strait-islander.svg" alt="Torres Strait Islander flag" width="72" height="36" /></li>
    </ul>
    <div>
      <h2 id="country-title" class="label">Acknowledgement of Country</h2>
      <p>I live and work on the lands of the Wurundjeri Woi-wurrung people of the Kulin Nation. I pay my respects to their Elders, past and present, and to all Aboriginal and Torres Strait Islander peoples.</p>
    </div>
  </div>
</aside>

<style>
  /* DS footer: deep navy ground, ivory and dim-blue text */
  .footer { background: var(--surface-invert); color: var(--text-on-invert); padding-top: var(--space-xl); }
  .footer a { color: var(--text-on-invert); }
  .footer a:hover { color: var(--text-invert-dim); }
  .footer :focus-visible { outline-color: var(--text-on-invert); }
  .footer__main { display: grid; gap: var(--space-l); align-items: start; padding-bottom: var(--space-l); }
  .footer__brandrow { display: flex; align-items: center; justify-content: space-between; gap: var(--space-m); }
  .footer__brand { display: inline-flex; min-height: 44px; align-items: center; }
  .footer__summary { margin: var(--space-s) 0 0; max-width: 34ch; font-family: var(--font-display); font-size: var(--fluid-display-sm); line-height: var(--lh-snug); color: var(--text-on-invert); }
  /* the seal: seal red on the navy reads at 3.4:1, clear of the 3:1 non-text contrast minimum */
  .footer__seal { display: block; width: 2.75rem; height: 2.75rem; flex: none; }
  .footer__base {
    display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-xs) var(--space-l);
    padding-block: var(--space-m); border-top: 1px solid var(--border-invert);
  }
  .footer__base p { margin: 0; color: var(--text-invert-dim); }
  /* the two legal links and Back to top: one line, the button pushed to the far right */
  .footer__legal { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-xs) var(--space-l); flex: 1 1 auto; }
  .footer__legal a { display: inline-flex; align-items: center; min-height: 44px; font-size: var(--text-sm); white-space: nowrap; }
  .footer__end { margin-left: auto; }
  /* Back to top: a proper button, an outlined pill on the navy with an up arrow; fills ivory on hover */
  .footer__top {
    display: inline-flex; align-items: center; gap: 0.4rem; min-height: 44px; padding: 0 1rem; cursor: pointer; white-space: nowrap;
    font: inherit; font-size: var(--text-sm); font-weight: var(--fw-semibold); color: var(--text-on-invert);
    background: transparent; border: 1px solid var(--text-on-invert); border-radius: 22px;
    transition: background var(--dur-med) var(--ease-standard), color var(--dur-med) var(--ease-standard);
  }
  .footer__top svg { width: 14px; height: 14px; fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
  .footer__top:hover { background: var(--text-on-invert); color: var(--surface-invert); }
  .footer__top:focus-visible { outline: 2px solid var(--text-on-invert); outline-offset: 3px; }
  /* phones: the copyright on its own line, then the links and the button on one line */
  @media (max-width: 39.99rem) {
    .footer__base p { flex-basis: 100%; }
    .footer__legal { gap: var(--space-xs) var(--space-s); }
    .footer__top { padding: 0 0.8rem; }
  }

  .country { background: var(--surface-page); border-top: 4px solid var(--surface-invert); }
  .country__inner { display: flex; flex-wrap: wrap; align-items: flex-start; gap: var(--space-m) var(--space-l); padding-block: var(--space-l); }
  /* side by side (Ed, round 12: stacked, they took too much room on phones) */
  .country__flags { list-style: none; margin: 0; padding: 0; display: flex; gap: var(--space-xs); }
  /* exactly the same size (both drawn at 1:2) */
  .country__flags img { display: block; width: 72px; height: 36px; box-shadow: 0 0 0 1px var(--border-hairline); }
  .country h2 { color: var(--gold-text); margin: 0 0 var(--space-2); }
  .country p { margin: 0; max-width: 70ch; font-size: var(--text-sm); color: var(--text-primary); }
</style>

<script>
  import { scrollToY } from '../scripts/smooth-scroll';
  // Back to top: smooth only when motion is fine, and focus lands at the top so keyboard users start over too
  const top = document.querySelector<HTMLButtonElement>('[data-back-to-top]');
  top?.addEventListener('click', () => {
    const smooth = window.matchMedia('(prefers-reduced-motion: no-preference)').matches;
    scrollToY(0, { immediate: !smooth });
    document.querySelector<HTMLElement>('.nav__brand')?.focus({ preventScroll: true });
    history.replaceState(null, '', location.pathname + location.search);
  });
</script>
