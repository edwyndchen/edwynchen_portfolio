---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import WorkshopCard from '../../components/WorkshopCard.astro';
import Contact from '../../components/Contact.astro';
import { publishedWorkshop, skillsOf, skillKey } from '../../lib/workshop';
import { site } from '../../data/site';

const entries = publishedWorkshop(await getCollection('workshop'), import.meta.env.DEV);
const skills = skillsOf(entries);
---
<BaseLayout title={`Workshop | ${site.name}`} description="Personal projects and experiments by Edwyn Chen.">
  <!-- the header is a lattice screen, not a card: the window lattice fills the band and clears behind the words -->
  <header class="ws-head">
    <!-- a painted window lattice (Seedream, see image-prompts.md): swap the file to change it -->
    <div class="ws-head__lattice" style="--lattice: url(/workshop/lattice-octagon.webp)"></div>
    <div class="wrap ws-head__inner">
      <h1>Workshop</h1>
      <p class="ws-head__dek">Side projects and experiments from my bench. Some get fired and glazed. Others stay sketches, and that’s fine.</p>
    </div>
  </header>

  <section class="wrap ws" aria-labelledby="ws-skills-title" data-workshop>
    {skills.length > 0 && (
      <div class="ws__skills">
        <h2 id="ws-skills-title" class="label">Brushes and tools</h2>
        <!-- a plain list without JS; the script turns each item into a filter toggle -->
        <ul class="ws__chips" data-chips>
          {skills.map((s) => <li data-key={skillKey(s)}>{s}</li>)}
        </ul>
        <p class="ws__count" aria-live="polite" data-count></p>
      </div>
    )}
    {entries.length > 0 ? (
      <ol class="ws__list" aria-label="Pieces">
        {entries.map((e) => <li data-entry><WorkshopCard entry={e} /></li>)}
      </ol>
    ) : (
      <p class="ws__empty">The bench is empty for now. Back soon.</p>
    )}
  </section>
  <Contact />
</BaseLayout>

<style>
  .ws-head { position: relative; overflow: hidden; padding-block: clamp(3.5rem, 10vh, 7rem); }
  /* the lattice fades out towards the words, so they sit in a clearing, never on top of the bars */
  .ws-head .ws-head__lattice {
    position: absolute; inset: 0; background: var(--lattice) center / cover;
    /* ...and feathers into the paper top and bottom, so the screen never ends on a ruled edge */
    -webkit-mask-image: radial-gradient(ellipse 60% 85% at 22% 50%, transparent 35%, #000 80%), linear-gradient(to bottom, transparent, #000 22%, #000 78%, transparent);
    mask-image: radial-gradient(ellipse 60% 85% at 22% 50%, transparent 35%, #000 80%), linear-gradient(to bottom, transparent, #000 22%, #000 78%, transparent);
    -webkit-mask-composite: source-in; mask-composite: intersect;
  }
  .ws-head__inner { position: relative; }
  .ws-head h1 { font-size: var(--step-4); margin: 0 0 var(--space-m); max-width: 12ch; }
  .ws__skills { position: relative; }
  .ws-head__dek { font-size: var(--step-1); line-height: var(--lh-normal); color: var(--text-secondary); margin: 0; max-width: 34ch; }
  @media (max-width: 47.99rem) {
    .ws-head .ws-head__lattice {
      -webkit-mask-image: linear-gradient(to bottom, transparent, #000 12%, transparent 32%, transparent 82%, #000 92%, transparent);
      mask-image: linear-gradient(to bottom, transparent, #000 12%, transparent 32%, transparent 82%, #000 92%, transparent);
      -webkit-mask-composite: source-over; mask-composite: add;
    }
  }
  .ws { padding-top: var(--space-xl); padding-bottom: var(--space-xl); }
  .ws__skills { margin-bottom: var(--space-l); }
  .ws__skills h2 { color: var(--gold-text); margin: 0 0 var(--space-s); }
  .ws__chips { list-style: none; padding: 0; margin: 0; display: flex; flex-wrap: wrap; gap: var(--space-xs); }
  .ws__chips li { padding: 6px 12px; border: 1px solid var(--border-hairline); color: var(--text-brand); font-size: var(--text-sm); }
  .ws__chips li:has(button) { padding: 0; border: 0; }
  /* the buttons are made by the script below, so they carry no scope attribute: style them globally */
  .ws__chips :global(button) {
    min-height: 44px; padding: 0 14px; font: inherit; font-size: var(--text-sm); cursor: pointer;
    color: var(--text-brand); background: var(--surface-raised); border: 1px solid var(--border-default); border-radius: 0;
    transition: background-color var(--dur-med) var(--ease-standard), color var(--dur-med) var(--ease-standard);
  }
  .ws__chips :global(button:hover) { border-color: var(--border-strong); }
  .ws__chips :global(button[aria-pressed='true']) { background: var(--action-primary); border-color: var(--action-primary); color: var(--text-on-brand); }
  .ws__count { margin: var(--space-s) 0 0; min-height: 1.5em; font-size: var(--text-sm); color: var(--text-secondary); }
  .ws__list { list-style: none; padding: 0; margin: 0; display: grid; gap: var(--space-l); align-items: stretch; }
  .ws__list > li { display: grid; }
  .ws__list > li[hidden] { display: none; }
  @media (min-width: 48rem) { .ws__list { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (min-width: 75rem) { .ws__list { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  .ws__empty { color: var(--text-secondary); }
</style>

<script>
  // Skills filter: each skill toggles; cards that carry any pressed skill stay. None pressed shows everything.
  const root = document.querySelector<HTMLElement>('[data-workshop]');
  const chips = root?.querySelector<HTMLUListElement>('[data-chips]');
  const count = root?.querySelector<HTMLElement>('[data-count]');
  const cards = [...(root?.querySelectorAll<HTMLElement>('[data-entry]') ?? [])];
  if (root && chips && count && cards.length > 1) {
    const on = new Set<string>();
    const apply = () => {
      let shown = 0;
      for (const li of cards) {
        const keys = (li.querySelector<HTMLElement>('[data-skills]')?.dataset.skills ?? '').split(' ');
        const show = on.size === 0 || keys.some((k) => on.has(k));
        li.hidden = !show;
        if (show) shown++;
      }
      count.textContent = on.size === 0 ? '' : `Showing ${shown} of ${cards.length} pieces`;
    };
    for (const li of chips.querySelectorAll<HTMLLIElement>('li')) {
      const key = li.dataset.key!;
      const b = document.createElement('button');
      b.type = 'button';
      b.textContent = li.textContent;
      b.setAttribute('aria-pressed', 'false');
      b.addEventListener('click', () => {
        const pressed = !on.has(key);
        if (pressed) on.add(key); else on.delete(key);
        b.setAttribute('aria-pressed', String(pressed));
        apply();
      });
      li.replaceChildren(b);
    }
  }
</script>
