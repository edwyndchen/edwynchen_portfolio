---
// Tester page (Ed, 2026-10-05): try swirlier brush transitions and new Workshop lattices before any goes live.
// Not linked anywhere and kept out of search. Delete before launch, or once Ed has picked.
import BaseLayout from '../../layouts/BaseLayout.astro';
import frames from '../../data/brush-lab.json';
const NAMES: Record<string, string> = {
  straight: 'Current: straight strokes',
  waves: 'Waves: long S-curves',
  loops: 'Loops: rolling cloud curls',
  vortex: 'Vortex: spirals out from the middle',
};
const LATTICES: [string, string][] = [
  ['ice', 'Cracked ice'], ['fret', 'Key fret'], ['begonia', 'Begonia and circles'], ['octagon', 'Octagons and plum blossom'],
];
---
<BaseLayout title="Lab | Edwyn Chen" description="Tester page." noindex>
  <div class="wrap lab">
    <h1>Lab</h1>
    <p class="lab__dek">Press a card to play its page transition (cover in cobalt, a beat, then the new page painted in). The live site still uses the first one.</p>
    <div class="lab__grid">
      {Object.entries(frames).map(([name, n]) => (
        <button class="demo" type="button" data-demo style={`--nc: ${n.cover}; --nr: ${n.reveal}; --cover: url(/lab/brush-${name}-cover.png); --reveal: url(/lab/brush-${name}-reveal.png)`}>
          <span class="demo__page demo__old">
            <img src="/hero/mid.webp" alt="" />
            <span class="demo__title">Edwyn Chen</span>
          </span>
          <span class="demo__page demo__new">
            <img src="/images/ed-porcelain.webp" alt="" class="demo__ed" />
            <span class="demo__title">About me</span>
          </span>
          <span class="demo__label">{NAMES[name] ?? name}</span>
        </button>
      ))}
    </div>

    <h2>Mist and lattice doors</h2>
    <p class="lab__dek">Press to play. The mist rolls in from both sides and parts on the new page; the doors slide shut on Ed's mark and open again.</p>
    <div class="lab__grid">
      <button class="demo demo--mist" type="button" data-scene="mist">
        <span class="demo__page demo__plain demo__a"><img src="/hero/mid.webp" alt="" /><span class="demo__title">Edwyn Chen</span></span>
        <span class="demo__page demo__plain demo__b"><img src="/images/ed-porcelain.webp" alt="" class="demo__ed" /><span class="demo__title">About me</span></span>
        <img class="mist mist--left" src="/lab/mist-bank.webp" alt="" />
        <img class="mist mist--right" src="/lab/mist-bank.webp" alt="" />
        <span class="demo__label">Mist: clouds roll in and part</span>
      </button>
      {[1, 2].map((n) => (
        <button class="demo demo--doors" type="button" data-scene="doors">
          <span class="demo__page demo__plain demo__a"><img src="/hero/mid.webp" alt="" /><span class="demo__title">Edwyn Chen</span></span>
          <span class="demo__page demo__plain demo__b"><img src="/images/ed-porcelain.webp" alt="" class="demo__ed" /><span class="demo__title">About me</span></span>
          {['left', 'right'].map((side) => (
            <span class={`door door--${side}`}>
              <span class="door__art">
                <img src={`/lab/doors-${n}.webp`} alt="" />
                <svg class="door__mark" viewBox="0 0 160 160" set:html='<path d="M74.8232 54.8232H36.5137C40.9046 47.2328 47.2328 40.9036 54.8232 36.5127V44.8232H64.8232V21.7129C43.739 27.1395 27.1395 43.739 21.7129 64.8232H74.8232V74.8232H10C12.4472 40.1484 40.1484 12.4472 74.8232 10V54.8232Z" /><path d="M74.8232 104.823H36.5137C40.9046 112.414 47.2328 118.743 54.8232 123.134V114.823H64.8232V137.934C43.739 132.507 27.1395 115.907 21.7129 94.8232H74.8232V84.8232H10C12.4472 119.498 40.1484 147.199 74.8232 149.646V104.823Z" /><path d="M84.8232 54.8232H123.133C118.742 47.2328 112.414 40.9036 104.823 36.5127V44.8232H94.8232V21.7129C115.907 27.1395 132.507 43.739 137.934 64.8232H84.8232V74.8232H149.646C147.199 40.1484 119.498 12.4472 84.8232 10V54.8232Z" /><path d="M84.8232 104.823H123.133C118.742 112.414 112.414 118.743 104.823 123.134V114.823H94.8232V137.934C115.907 132.507 132.507 115.907 137.934 94.8232H84.8232V84.8232H149.646C147.199 119.498 119.498 147.199 84.8232 149.646V104.823Z" />' />
              </span>
            </span>
          ))}
          <span class="demo__label">{n === 1 ? 'Doors A: key fret and cracked ice' : 'Doors B: octagons and cloud curls'}</span>
        </button>
      ))}
    </div>

    <h2>Workshop header lattices</h2>
    <p class="lab__dek">Each painted in the art's cobalt and lifted pale, so the title reads over it. The live Workshop page uses whichever Ed picks.</p>
    {LATTICES.map(([key, label]) => (
      <section class="ws-try" style={`--lattice: url(/workshop/lattice-${key}.webp)`}>
        <div class="ws-try__inner">
          <p class="label">{label}</p>
          <p class="ws-try__title">Workshop</p>
          <p class="ws-try__dek">Side projects and experiments from my bench.</p>
        </div>
      </section>
    ))}
  </div>
</BaseLayout>

<style>
  .lab { padding-block: var(--space-xl) var(--space-2xl); }
  .lab h1 { font-size: var(--step-4); margin: 0 0 var(--space-s); }
  .lab h2 { font-size: var(--step-3); margin: var(--space-2xl) 0 var(--space-s); }
  .lab__dek { max-width: 60ch; color: var(--text-secondary); margin: 0 0 var(--space-l); }
  .lab__grid { display: grid; gap: var(--space-l); grid-template-columns: repeat(auto-fill, minmax(min(100%, 30rem), 1fr)); }

  .demo { position: relative; display: block; width: 100%; aspect-ratio: 3 / 2; padding: 0; border: 1px solid var(--border-default); background: var(--surface-brand); cursor: pointer; overflow: hidden; font: inherit; }
  .demo:focus-visible { outline: 2px solid var(--focus-ring); outline-offset: 3px; }
  .demo__page { position: absolute; inset: 0; display: grid; place-items: center; background: var(--surface-page); -webkit-mask-repeat: no-repeat; mask-repeat: no-repeat; }
  .demo__page img { position: absolute; inset: auto 0 0 0; width: 100%; }
  .demo__ed { inset: 8% auto auto 58% !important; width: 30% !important; }
  .demo__title { position: relative; font-family: var(--font-display); font-size: clamp(1.5rem, 4vw, 2.6rem); color: var(--text-brand); }
  .demo__old { -webkit-mask-image: var(--cover); mask-image: var(--cover); -webkit-mask-size: calc(var(--nc) * 100%) 100%; mask-size: calc(var(--nc) * 100%) 100%; -webkit-mask-position: 0 0; mask-position: 0 0; }
  .demo__new { -webkit-mask-image: var(--reveal); mask-image: var(--reveal); -webkit-mask-size: calc(var(--nr) * 100%) 100%; mask-size: calc(var(--nr) * 100%) 100%; -webkit-mask-position: 0 0; mask-position: 0 0; }
  .demo.is-playing .demo__old { animation: lab-step 0.6s steps(calc(var(--nc) - 1), jump-none) both; }
  .demo.is-playing .demo__new { animation: lab-step 0.7s 0.68s steps(calc(var(--nr) - 1), jump-none) both; }
  .demo.is-done .demo__old { -webkit-mask-position: 100% 0; mask-position: 100% 0; }
  .demo.is-done .demo__new { -webkit-mask-position: 100% 0; mask-position: 100% 0; }
  .demo__label { position: absolute; left: 0; right: 0; bottom: 0; padding: 0.6rem 0.9rem; background: color-mix(in srgb, var(--surface-page) 92%, transparent); color: var(--text-primary); font-size: var(--text-sm); font-weight: var(--fw-semibold); text-align: left; }
  @keyframes lab-step { from { -webkit-mask-position: 0% 0; mask-position: 0% 0; } to { -webkit-mask-position: 100% 0; mask-position: 100% 0; } }

  /* scene demos: the two pages swap under the cover */
  .demo__plain { -webkit-mask-image: none; mask-image: none; }
  .demo__b { visibility: hidden; }
  .demo.is-b .demo__a { visibility: hidden; }
  .demo.is-b .demo__b { visibility: visible; }
  .mist { position: absolute; top: 0; height: 100%; width: 72%; object-fit: cover; pointer-events: none; }
  .mist--left { left: 0; -webkit-mask-image: linear-gradient(to right, #000 70%, transparent); mask-image: linear-gradient(to right, #000 70%, transparent); }
  .mist--right { right: 0; -webkit-mask-image: linear-gradient(to right, #000 70%, transparent); mask-image: linear-gradient(to right, #000 70%, transparent); }
  .door { position: absolute; top: 0; bottom: 0; width: 50%; overflow: hidden; pointer-events: none; }
  .door--left { left: 0; }
  .door--right { right: 0; }
  .door__art { position: absolute; top: 0; height: 100%; width: 200%; }
  .door--left .door__art { left: 0; }
  .door--right .door__art { right: 0; }
  .door__art img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .door__mark { position: absolute; left: 50%; top: 50%; width: 30%; max-height: 40%; aspect-ratio: 1; translate: -50% -50%; fill: var(--paper-0); }
  .ws-try { position: relative; margin-bottom: var(--space-l); padding: clamp(2.5rem, 7vh, 5rem) var(--space-l); overflow: hidden; border-block: var(--rule-hair); }
  .ws-try::before {
    content: ''; position: absolute; inset: 0; background: var(--lattice) center / cover;
    -webkit-mask-image: radial-gradient(ellipse 55% 90% at 22% 50%, transparent 30%, #000 78%), linear-gradient(to bottom, transparent, #000 18%, #000 82%, transparent);
    mask-image: radial-gradient(ellipse 55% 90% at 22% 50%, transparent 30%, #000 78%), linear-gradient(to bottom, transparent, #000 18%, #000 82%, transparent);
    -webkit-mask-composite: source-in; mask-composite: intersect;
  }
  .ws-try__inner { position: relative; }
  .ws-try__title { font-family: var(--font-display); font-size: var(--step-4); color: var(--text-brand); margin: 0 0 var(--space-s); line-height: 1; }
  .ws-try__dek { margin: 0; font-size: var(--step-1); color: var(--text-secondary); max-width: 34ch; }
</style>

<script>
  import { gsap } from 'gsap';
  // mist: banks roll in from both sides, the page swaps under them, then they part; doors: shut on the mark, open
  for (const d of document.querySelectorAll<HTMLElement>('[data-scene]')) {
    const mist = d.dataset.scene === 'mist';
    const [l, r] = mist ? [d.querySelector('.mist--left'), d.querySelector('.mist--right')] : [d.querySelector('.door--left'), d.querySelector('.door--right')];
    // both covers wait off-stage (the right mist bank is the left one mirrored)
    const off = mist ? 105 : 101;
    gsap.set(l, { xPercent: -off });
    gsap.set(r, { xPercent: off, scaleX: mist ? -1 : 1 });
    d.addEventListener('click', () => {
      d.classList.remove('is-b');
      const [inT, outT, outAt] = mist ? [0.8, 1.0, 1.05] : [0.7, 0.9, 1.25];
      const ease = mist ? 'power2.inOut' : 'power3.inOut';
      gsap.timeline()
        .fromTo(l, { xPercent: -off }, { xPercent: 0, duration: inT, ease }, 0)
        .fromTo(r, { xPercent: off }, { xPercent: 0, duration: inT, ease }, 0)
        .call(() => d.classList.add('is-b'), [], inT + 0.05)
        .to(l, { xPercent: -off, duration: outT, ease }, outAt)
        .to(r, { xPercent: off, duration: outT, ease }, outAt);
    });
  }
</script>

<script>
  // each card plays once per press: back to the old page, then the two-stage paint
  for (const d of document.querySelectorAll<HTMLElement>('[data-demo]')) {
    d.addEventListener('click', () => {
      d.classList.remove('is-playing', 'is-done');
      void d.offsetWidth;
      d.classList.add('is-playing');
      d.querySelector('.demo__new')!.addEventListener('animationend', () => d.classList.add('is-done'), { once: true });
    });
  }
</script>
