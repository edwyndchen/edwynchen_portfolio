---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PlaceholderFrame from '../../components/PlaceholderFrame.astro';
import CaseToc from '../../components/CaseToc.astro';
import AtAGlance from '../../components/AtAGlance.astro';
import CaseNav from '../../components/CaseNav.astro';
import Gallery from '../../components/Gallery.astro';
import Contact from '../../components/Contact.astro';
import { neighbours, sortCaseStudies } from '../../lib/case-studies';
import { site } from '../../data/site';
import '../../styles/prose.css';

export async function getStaticPaths() {
  const sorted = sortCaseStudies(await getCollection('caseStudies'));
  return sorted.map((entry) => ({ params: { slug: entry.id }, props: { entry, ...neighbours(sorted, entry.id) } }));
}

const { entry, prev, next } = Astro.props;
const { Content, headings } = await render(entry);
const d = entry.data;
// the hero shows its own image when set, else the cover art
const heroSrc = d.hero || d.cover;
const heroAlt = d.hero ? d.heroAlt : d.coverAlt;
// tags: what kind of work, then where it ran
const tags = [d.discipline === 'design-system' ? 'Design system' : 'Product design', ...d.platforms.split(',').map((t) => t.trim()).filter(Boolean)];
const overview = d.overview.split(/\n\s*\n/).map((p) => p.trim()).filter(Boolean);
---
<BaseLayout title={`${d.title} | ${site.name}`} description={d.dek}>
  <!-- the case study in a neutral palette (Ed, round 12): cream band, cream dividers, gold headings and accents, so
       the work's own images lead; the hero still runs full width behind the top of the page -->
  <article class="case">
    <!-- 1. the image, edge to edge -->
    <div class="case-hero">
      {heroSrc
        ? <img class="case-hero__img" src={heroSrc} alt={heroAlt} width="1600" height="900" fetchpriority="high" />
        : <PlaceholderFrame id="case-hero" ratio="16 / 9" hint="Add a hero image in Keystatic" />}
    </div>

    <!-- 2. the blue band: what this case is, at a glance -->
    <header class="case-band">
      <div class="wrap case-band__inner">
        <div class="case-band__intro">
          <h1>{d.title}</h1>
          <ul class="case-band__tags" aria-label="Tags">
            {tags.map((t) => <li>{t}</li>)}
          </ul>
          {overview.length > 0 && (
            <section class="case-band__overview" aria-labelledby="overview-title">
              <h2 id="overview-title" class="label">Overview</h2>
              {overview.map((para) => <p>{para}</p>)}
            </section>
          )}
        </div>
        <div class="case-band__facts">
          <AtAGlance data={d} />
        </div>
      </div>
    </header>

    <!-- 3. the finished work first, as a carousel (Ed, round 9: show the result before the story); placeholder frames
         until the images are added in Keystatic (Finished work) -->
    <section class="wrap case-finals" aria-labelledby="finals-title">
      <h2 id="finals-title" class="label">The finished work</h2>
      <Gallery label="Finished work" items={d.finals} />
    </section>

    <!-- 4. the story, with its On this page links beside it -->
    <div class="wrap case-body">
      <CaseToc headings={headings} />
      <div class="prose">
        <Content />
      </div>
    </div>
  </article>
  <CaseNav prev={prev} next={next} />
  <Contact />
</BaseLayout>

<style>
  .case-finals { padding-top: var(--space-xl); }
  .case-finals h2 { margin: 0; }
  .case-finals > :global(.gallery.gallery) { margin-block: var(--space-m) 0; }
  .case-hero { overflow: hidden; }
  .case-hero__img {
    display: block; width: 100%; height: auto; max-height: min(78svh, 56.25vw); object-fit: cover; object-position: 50% 45%;
    mix-blend-mode: multiply;
    /* the art's paper dissolves into the page at the top, so the nav never sits on a ruled edge */
    -webkit-mask-image: linear-gradient(to bottom, transparent, #000 8%);
    mask-image: linear-gradient(to bottom, transparent, #000 8%);
  }

  /* The neutral palette (Ed, round 12): inside the case study the brand blue gives way to gold for headings, labels,
     links and markers, and the dividers turn warm cream, so the paintings and screens carry the colour.
     Contrast: gold-600 on paper-50 6.1:1, on paper-100 5.6:1. */
  .case {
    --text-brand: var(--gold-600); --cobalt: var(--gold-600); --action-primary: var(--gold-600); --action-primary-hover: var(--gold-700);
    --border-hairline: var(--paper-300); --border-default: var(--paper-300); --border-strong: var(--gold-500);
    --surface-brand-soft: var(--gold-50); --frame-bg: var(--paper-100); --frame-lattice: var(--paper-300);
    /* the rule shorthands resolve where they're defined (:root), so they're restated here to pick up the cream */
    --rule: 1px solid var(--border-strong); --rule-soft: 1px solid var(--border-default); --rule-hair: 1px solid var(--border-hairline);
  }
  /* the band: all the case's info, on porcelain cream with a cream line above and below */
  .case-band { background: var(--surface-sunken); border-block: var(--rule-hair); padding-block: var(--space-xl); }
  .case-band__inner { display: grid; gap: var(--space-xl); }
  @media (min-width: 60rem) { .case-band__inner { grid-template-columns: minmax(0, 6fr) minmax(0, 5fr); column-gap: var(--space-2xl); } }
  .case-band h1 { font-size: var(--fluid-display-xl); color: var(--gold-600); margin: 0 0 var(--space-m); max-width: 16ch; }
  .case-band__tags { list-style: none; margin: 0 0 var(--space-l); padding: 0; display: flex; flex-wrap: wrap; gap: var(--space-2); }
  .case-band__tags li {
    padding: 5px 11px; font-size: var(--text-xs); font-weight: var(--fw-semibold); letter-spacing: var(--ls-caps); text-transform: uppercase;
    border: 1px solid var(--paper-300); border-radius: var(--radius-round); color: var(--gold-600); background: var(--surface-raised);
  }
  .case-band__overview h2 { color: var(--gold-text); margin: 0 0 var(--space-s); }
  .case-band__overview p { margin: 0 0 var(--space-m); max-width: 60ch; font-size: var(--step-0); line-height: var(--lh-relaxed); }
  .case-band__overview p:first-of-type { font-family: var(--font-display); font-size: var(--step-1); line-height: var(--lh-snug); color: var(--ink); }
  .case-band__facts { display: grid; gap: var(--space-xl); align-content: start; }

  .case-body { position: relative; padding-top: var(--space-2xl); display: grid; gap: var(--space-l); }
  @media (min-width: 60rem) { .case-body { grid-template-columns: 13rem minmax(0, 1fr); column-gap: var(--space-2xl); } }
  /* headings land below the sticky nav (and the phone link strip) */
  .case-body :global(.prose h2) { scroll-margin-top: 6rem; }
  @media (max-width: 59.99rem) { .case-body :global(.prose h2) { scroll-margin-top: 8.5rem; } }
</style>
