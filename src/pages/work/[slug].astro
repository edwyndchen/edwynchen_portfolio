---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Plate from '../../components/Plate.astro';
import Flora from '../../components/Flora.astro';
import AtAGlance from '../../components/AtAGlance.astro';
import StatPanels from '../../components/StatPanels.astro';
import CaseNav from '../../components/CaseNav.astro';
import Contact from '../../components/Contact.astro';
import { neighbours, sortCaseStudies } from '../../lib/case-studies';
import { site } from '../../data/site';
import '../../styles/prose.css';

export async function getStaticPaths() {
  const sorted = sortCaseStudies(await getCollection('caseStudies'));
  return sorted.map((entry) => ({ params: { slug: entry.id }, props: { entry, ...neighbours(sorted, entry.id) } }));
}

const { entry, prev, next } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;
---
<BaseLayout title={`${d.title} | ${site.name}`} description={d.dek}>
  <article>
    <header class="wrap case-head">
      <Flora plant="banksia" side="right" class="flora--case" />
      <Plate>
        <p class="label case-head__kicker">{d.discipline === 'design-system' ? 'Design system' : 'Product design'}</p>
        <h1>{d.title}</h1>
        <p class="case-head__dek">{d.dek}</p>
      </Plate>
      {d.cover && <img class="case-head__cover" src={d.cover} alt={d.coverAlt} width="1600" height="900" />}
    </header>

    <div class="wrap case-summary">
      <StatPanels metrics={d.metrics} />
      <AtAGlance data={d} />
    </div>

    <div class="wrap case-body">
      <div class="prose">
        <Content />
      </div>
    </div>
  </article>
  <CaseNav prev={prev} next={next} />
  <Contact />
</BaseLayout>

<style>
  .case-head { padding-top: var(--space-xl); position: relative; overflow-x: clip; display: grid; grid-template-columns: minmax(0, 1fr); }
  /* the banksia sits beside the title plate, never behind it: in flow, above the plate's right side on phones... */
  .case-head :global(.flora--case) { position: relative; justify-self: end; margin-bottom: var(--space-s); }
  /* ...and in its own column to the right of the plate on desktop */
  @media (min-width: 60rem) {
    .case-head { grid-template-columns: minmax(0, 1fr) auto; column-gap: var(--space-xl); align-items: center; }
    .case-head :global(.flora--case) { grid-column: 2; grid-row: 1; margin-bottom: 0; }
    .case-head > :global(.plate) { grid-column: 1; grid-row: 1; }
    .case-head__cover { grid-column: 1 / -1; }
  }
  .case-head > :global(.plate), .case-head__cover { position: relative; z-index: 1; }
  .case-head h1 { font-size: var(--fluid-display-xl); margin: var(--space-s) 0 var(--space-m); }
  .case-head__kicker { color: var(--gold-text); margin: 0; }
  .case-head__dek { font-size: var(--step-1); line-height: var(--lh-normal); color: var(--text-secondary); margin: 0; max-width: 40ch; }
  .case-head__cover { margin-top: var(--space-l); width: 100%; height: auto; mix-blend-mode: multiply; }
  /* results first, then the facts, then a longer pause before the story starts */
  .case-summary { display: grid; gap: var(--space-xl); padding-top: var(--space-xl); }
  .case-body { padding-top: var(--space-2xl); }
</style>
