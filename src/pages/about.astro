---
import BaseLayout from '../layouts/BaseLayout.astro';
import Contact from '../components/Contact.astro';
import { site } from '../data/site';
import { LINES, ENERGY, FRAMES, LOW, stateFor, frameFor } from '../scripts/coffee';
import ProvenResults from '../components/ProvenResults.astro';
import { photos } from '../data/about-photos';
// Where Ed has worked, newest first: just the places (Ed, round 12; the detail lives on the resume and in the case
// studies).
const JOBS = [
  { company: 'In Form Media', brands: 'Punters and Racenet', role: 'Product Designer', years: '2023–2026' },
  { company: 'EonX', brands: 'White-label fintech, including Mastercard', role: 'UX/UI Designer', years: '2022–2023' },
  { company: 'New Aim', brands: 'Furniture and homewares', role: 'Graphic Designer', years: '2020–2021' },
];
// Ed's two signs, each with its painting and the character it goes by
const SIGNS = [
  {
    name: 'The pig', kind: 'Chinese zodiac, the Year of the Pig', glyph: '亥',
    art: { src: '/scroll/pig.webp', width: 600, height: 451, alt: 'Brush painting of a spotted pig flying on white crane wings' },
    body: 'Pigs are known for being generous, honest and hard-working, and easy to get along with. That’s how I try to show up on a team.',
  },
  {
    name: 'The water bearer', kind: 'Aquarius, my star sign', glyph: '瓶',
    art: { src: '/about/vase.webp', width: 436, height: 900, alt: 'Brush painting of a blue-and-white porcelain vase with a lotus medallion' },
    body: 'Aquarians are curious, independent thinkers who want to make things better for people. It’s the same pull that keeps me coming back to accessibility.',
  },
];
const startState = stateFor(ENERGY.start);
const startFrame = frameFor(ENERGY.start);
---
<!-- The About page (Ed, round 11): a coffee game up top (feed Ed coffee, watch his energy bar and his face change),
     then where he's worked and what came of it, a bit more about him, and why the pig and the water bearer. -->
<BaseLayout title={`About | ${site.name}`} description="About Edwyn Chen, product designer in Melbourne: where I've worked, the results, and a bit more about me.">
  <section class="ab-hero wrap" aria-labelledby="ab-title">
    <div class="ab-hero__text">
      <h1 id="ab-title">About me<span class="ab-hero__mark" aria-hidden="true" lang="zh-Hant">陳</span></h1>
      <p class="ab-hero__lead">I design digital products and I care about getting them right, both how they work and how they feel to use.</p>
      <p>Coffee-fuelled designer and gym junkie. Speaking of coffee, keep me topped up while you read.</p>
    </div>

    <!-- the coffee game: his energy over his head, his face below it, the cup under him -->
    <figure class:list={['coffee', { 'is-low': ENERGY.start < ENERGY.max * LOW }]} data-coffee-game data-energy={startState}>
      <div class="coffee__hp">
        <span class="coffee__hp-label label" id="coffee-hp">Energy</span>
        <div class="coffee__bar" role="meter" aria-labelledby="coffee-hp" aria-valuemin="0" aria-valuemax="100" aria-valuenow={ENERGY.start} data-energy-bar>
          <span class="coffee__fill" data-energy-fill style={`transform: scaleX(${ENERGY.start / 100})`}></span>
        </div>
        <!-- what he says sits right under the bar, so the two read together (Ed, round 12) -->
        <p class="coffee__line" role="status" data-coffee-line>{LINES[startState]}</p>
      </div>
      <!-- Ed is the button: carry the cup over and click him (or tap, or Enter) to give him a coffee. On touch screens a
           cup rises from his lower left and tips to his mouth (data-sip-cup, Ed, round 12). -->
      <div class="coffee__stage">
      <button class="coffee__face" type="button" data-coffee data-coffee-face aria-label="Give Ed a coffee">
        {Array.from({ length: FRAMES }, (_, i) => (
          <img class:list={['coffee__img', { 'is-on': i === startFrame }]} data-frame={i} src={`/about/face-${i + 1}.webp`}
            alt="" width="800" height="800" loading={i === startFrame ? 'eager' : 'lazy'} decoding="async" />
        ))}
      </button>
      <img class="coffee__sip" src="/about/cup.webp" alt="" width="400" height="411" aria-hidden="true" decoding="async" data-sip-cup />
      </div>
      <!-- phones and tablets: a plain button to give him a coffee (Ed, round 12) -->
      <button class="coffee__go button" type="button" data-caffeinate>Tap to caffeinate</button>
      <p class="coffee__hint"><span class="coffee__hint-mouse">Click Ed to give him a coffee.</span><span class="coffee__hint-touch">Tap Ed to give him a coffee.</span> <span class="coffee__count" data-coffee-count></span></p>
      <!-- the cup that follows the mouse over him (coffee.ts); fixed to the screen, so the page never moves it -->
      <img class="coffee__cup" src="/about/cup.webp" alt="" width="400" height="411" aria-hidden="true" decoding="async" data-cup />
    </figure>
  </section>

  <!-- the proven numbers (moved here from the home page, Ed, round 11c) -->
  <ProvenResults />

  <!-- where Ed has worked: just the places, a ledger of names (Ed, round 12) -->
  <section class="ab-work wrap" aria-labelledby="ab-work">
    <h2 id="ab-work">Where I’ve worked</h2>
    <ol class="ledger">
      {JOBS.map((j) => (
        <li class="ledger__row">
          <h3 class="ledger__company">{j.company}</h3>
          <p class="ledger__role">{j.role}<span class="ledger__brands">{j.brands}</span></p>
          <p class="ledger__years">{j.years}</p>
        </li>
      ))}
    </ol>
  </section>

  <!-- the two signs: a spread, each painting large over the character it goes by (Ed, round 12) -->
  <section class="signs wrap" aria-labelledby="ab-zodiac">
    <div class="signs__head">
      <h2 id="ab-zodiac">Why a pig and a water vase?</h2>
      <p>Tap me on the home page and I change outfits. Two of them are my signs.</p>
    </div>
    <div class="signs__pair">
      {SIGNS.map((g, i) => (
        <article class:list={['sign', `sign--${i ? 'vase' : 'pig'}`]}>
          <div class="sign__art">
            <span class="sign__glyph" lang="zh-Hant" aria-hidden="true">{g.glyph}</span>
            <img src={g.art.src} alt={g.art.alt} width={g.art.width} height={g.art.height} loading="lazy" decoding="async" />
          </div>
          <h3>{g.name}</h3>
          <p class="sign__kind">{g.kind}</p>
          <p class="sign__body">{g.body}</p>
        </article>
      ))}
    </div>
  </section>

  <!-- photos of Ed: shows once src/data/about-photos.ts lists some -->
  {photos.length > 0 && (
    <section class="snaps wrap" aria-labelledby="ab-snaps">
      <h2 id="ab-snaps" class="visually-hidden">Photos of me</h2>
      <ul class="snaps__row">
        {photos.map((p) => <li><img src={p.src} alt={p.alt} width={p.width} height={p.height} loading="lazy" decoding="async" /></li>)}
      </ul>
    </section>
  )}

  <Contact />
</BaseLayout>

<style>
  .ab-hero { display: grid; gap: var(--space-xl); align-items: center; padding-block: var(--space-xl); }
  @media (min-width: 48rem) { .ab-hero { grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); } }
  .ab-hero h1 { font-size: var(--fluid-display-xl); margin: 0 0 var(--space-m); }
  .ab-hero__mark { font-family: var(--font-cjk); font-weight: 400; font-size: 0.8em; color: var(--blue-400); margin-inline-start: 0.3em; }
  .ab-hero__lead { font-family: var(--font-display); font-style: italic; font-size: var(--fluid-display-sm); line-height: var(--lh-snug); color: var(--ink); max-width: 30ch; }

  /* the game: a porcelain plate holding his face, the energy bar over his head */
  .coffee { margin: 0; display: grid; gap: var(--space-s); justify-items: center; max-width: 24rem; width: 100%; justify-self: center; }
  .coffee__hp { width: 70%; display: grid; gap: 0.35rem; }
  .coffee__hp-label { color: var(--text-secondary); text-align: center; }
  .coffee__bar { position: relative; height: 14px; border: var(--rule); outline: 1px solid var(--border-default); outline-offset: 2px; background: var(--surface-raised); overflow: hidden; }
  .coffee__fill {
    position: absolute; inset: 0; transform-origin: left; background: var(--action-primary);
    transition: transform 0.4s var(--ease-standard), background-color 0.4s var(--ease-standard);
  }
  /* running low: the bar pales towards the seal red */
  .coffee.is-low .coffee__fill { background: var(--text-seal); }
  .coffee__face {
    display: block; padding: 0; font: inherit; color: inherit; cursor: pointer;
    position: relative; width: 100%; aspect-ratio: 1; border-radius: 50%; overflow: hidden;
    border: var(--rule); outline: 1px solid var(--border-default); outline-offset: -8px; background: #fff; box-shadow: var(--shadow-sm); /* pure white behind his face (Ed) */
  }
  /* each frame crossfades into the next; the old one fades out a touch slower so there's never a gap (round 11b) */
  .coffee__img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; opacity: 0; transition: opacity 0.5s ease-in; }
  .coffee__img.is-on { transition: opacity 0.28s ease-out; }
  .coffee__img.is-on { opacity: 1; }
  .coffee__face.is-sip { animation: coffee-sip 0.45s var(--ease-standard); }
  @keyframes coffee-sip { 40% { transform: translateY(-6px) scale(1.02); } }
  .coffee__line { margin: 0.15rem 0 0; min-height: 1.5em; text-align: center; font-family: var(--font-display); font-style: italic; font-size: var(--text-lg); color: var(--text-brand); }
  .coffee__face:focus-visible { outline: 2px solid var(--focus-ring); outline-offset: 4px; }
  .coffee__face.has-cup { cursor: none; }
  .coffee__hint { margin: 0; text-align: center; font-size: var(--text-sm); color: var(--text-secondary); }
  .coffee__hint-touch { display: none; }
  /* touch screens: the cup that rises to his mouth, and the Tap to caffeinate button */
  .coffee__stage { position: relative; width: 100%; }
  .coffee__sip {
    position: absolute; left: 10%; top: 54%; width: 34%; height: auto; pointer-events: none; z-index: 1;
    transform-origin: 70% 80%; opacity: 0; transform: translate(-40%, 30%) scaleX(-1) rotate(0deg);
  }
  .coffee__sip.is-sip { animation: coffee-drink 1.1s var(--ease-standard); }
  @keyframes coffee-drink {
    0% { opacity: 0; transform: translate(-40%, 30%) scaleX(-1) rotate(0deg); }
    25% { opacity: 1; transform: translate(0, 0) scaleX(-1) rotate(0deg); }
    55% { opacity: 1; transform: translate(12%, -6%) scaleX(-1) rotate(-32deg); }
    80% { opacity: 1; transform: translate(0, 0) scaleX(-1) rotate(0deg); }
    100% { opacity: 0; transform: translate(-40%, 30%) scaleX(-1) rotate(0deg); }
  }
  .coffee__go { display: none; }
  @media (hover: none) { .coffee__go { display: inline-flex; } }
  @media (hover: none) { .coffee__hint-mouse { display: none; } .coffee__hint-touch { display: inline; } }
  /* the cup: its centre-left on the pointer, tilted towards him; it tips to pour on a click */
  .coffee__cup {
    position: fixed; left: 0; top: 0; z-index: 60; width: 92px; height: auto; pointer-events: none;
    transform: translate(-30%, -55%) rotate(-12deg); opacity: 0; transition: opacity 0.15s;
  }
  .coffee__cup.is-on { opacity: 1; }
  .coffee__cup.is-pour { animation: coffee-pour 0.5s var(--ease-standard); }
  @keyframes coffee-pour { 45% { transform: translate(-30%, -55%) rotate(-38deg); } }
  @media (prefers-reduced-motion: reduce) { .coffee__fill, .coffee__img { transition: none; } .coffee__face.is-sip, .coffee__sip.is-sip { animation: none; } }

  /* where I've worked: a ledger. Company names carry the weight; role and years sit quietly beside them */
  .ab-work { padding-block: var(--space-2xl) var(--space-xl); }
  .ab-work h2, .signs h2 { font-size: var(--step-3); margin: 0; text-wrap: balance; }
  .ledger { list-style: none; margin: var(--space-l) 0 0; padding: 0; border-top: var(--rule); }
  .ledger__row {
    display: grid; gap: 0.25rem var(--space-l); align-items: baseline;
    padding-block: clamp(1.1rem, 0.8rem + 1.2vw, 1.9rem); border-bottom: var(--rule-hair);
  }
  @media (min-width: 48rem) { .ledger__row { grid-template-columns: minmax(0, 5fr) minmax(0, 5fr) auto; } }
  .ledger__company { margin: 0; font-family: var(--font-display); font-weight: var(--fw-medium); font-size: var(--fluid-display-lg); line-height: 1.05; color: var(--cobalt); }
  .ledger__role { margin: 0; font-weight: var(--fw-semibold); color: var(--text-primary); }
  .ledger__brands { display: block; font-weight: 400; color: var(--text-secondary); font-size: var(--text-sm); }
  .ledger__years { margin: 0; color: var(--text-secondary); font-variant-numeric: tabular-nums; white-space: nowrap; }

  /* the signs: two columns, each painting large over a pale character, the words under it */
  .signs { padding-block: var(--space-xl) var(--space-2xl); }
  .signs__head { display: grid; gap: var(--space-s); max-width: 40rem; }
  .signs__head p { margin: 0; font-size: var(--step-1); color: var(--text-secondary); text-wrap: pretty; }
  .signs__pair { display: grid; gap: var(--space-xl) var(--space-2xl); margin-top: var(--space-xl); }
  @media (min-width: 48rem) { .signs__pair { grid-template-columns: 1fr 1fr; } }
  .sign { display: grid; align-content: start; gap: var(--space-xs); }
  .sign__art { --h: clamp(15rem, 9rem + 14vw, 24rem); position: relative; display: grid; place-items: end center; height: var(--h); margin-bottom: var(--space-m); }
  /* the pig flies: it sits a little above the line the vase stands on */
  .sign--pig .sign__art img { margin-bottom: calc(var(--h) * 0.12); }
  .sign__glyph {
    position: absolute; inset: 0; display: grid; place-items: center; pointer-events: none;
    font-family: var(--font-cjk); font-size: clamp(11rem, 6rem + 16vw, 19rem); line-height: 1; color: color-mix(in oklab, var(--blue-100) 60%, transparent);
  }
  .sign__art img { position: relative; width: auto; height: calc(var(--h) * 0.62); max-width: 88%; object-fit: contain; }
  .sign--vase .sign__art img { height: calc(var(--h) * 0.94); }
  .sign h3 { margin: 0; font-size: var(--fluid-display-md); color: var(--cobalt); }
  .sign__kind { margin: 0; font-weight: var(--fw-semibold); color: var(--text-primary); }
  .sign__body { margin: var(--space-xs) 0 0; max-width: 44ch; text-wrap: pretty; }

  /* photos of Ed, once added: a row that scrolls sideways on phones */
  .snaps { padding-bottom: var(--space-2xl); }
  .snaps__row { list-style: none; margin: 0; padding: 0; display: grid; grid-auto-flow: column; grid-auto-columns: minmax(14rem, 1fr); gap: var(--space-m); overflow-x: auto; scroll-snap-type: x mandatory; }
  .snaps__row li { scroll-snap-align: start; }
  .snaps__row img { width: 100%; aspect-ratio: 4 / 5; object-fit: cover; border: var(--rule); }
</style>

<script>
  import { initCoffee } from '../scripts/coffee';
  const game = document.querySelector<HTMLElement>('[data-coffee-game]');
  if (game) initCoffee(game);
</script>
